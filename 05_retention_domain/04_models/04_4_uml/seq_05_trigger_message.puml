@startuml seq_05_trigger_message
title SEQ-05. Отправка триггерного маркетингового сообщения\n(C4 Context: «Отправка триггерных маркетинговых сообщений» -> Каналы коммуникаций)

autonumber
skinparam responseMessageBelowArrow true

participant "CRM" as CRM
database "БД CRM\n(профиль, сегменты,\nистория коммуникаций)" as CRMDB
database "БД BI\n(аналитические витрины)" as BIDB
participant "Каналы коммуникаций\n(email / SMS / push)\n<<внешние сервисы>>" as CH
actor "Клиент" as Client
actor "Маркетолог" as Marketer

== Триггер ==
CRM -> CRM : Наступление триггера\n(изменение сегмента/метрик, брошенная корзина,\nусловия акции)

== Выбор получателей ==
CRM -> CRMDB : Выборка клиентов сегмента,\nсогласия на коммуникацию, контактов
CRMDB --> CRM : Список получателей

== Отправка ==
loop по получателям
    CRM -> CH : Отправка сообщения\n(push / SMS / email)
    CH -> Client : Доставка сообщения
    CH --> CRM : Статус доставки / открытия
    CRM -> CRMDB : Запись статуса в историю коммуникаций
end

== Аналитика кампании ==
CRM -> BIDB : Выгрузка результатов кампании\nв аналитические витрины
BIDB --> CRM : Подтверждение
CRM --> Marketer : Отчет по кампании\n(доставка, конверсия, реакция)
@enduml
