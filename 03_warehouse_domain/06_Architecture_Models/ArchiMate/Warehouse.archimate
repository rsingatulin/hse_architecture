<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="RetailMax Warehouse" id="WH_MODEL_001" version="5.0.0">
  <folder name="Strategy" id="id-8245e81bc9a74f139b96dfbd2796eb81" type="strategy"/>
  <folder name="Business" id="id-48322ce81e58403e8995433b621c5391" type="business">
    <element xsi:type="archimate:BusinessRole" name="Кладовщик" id="BR1">
      <documentation>Выполняет комплектацию и подтверждает передачу товара.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Начальник склада" id="BR2">
      <documentation>Утверждает пересчёт и корректировку.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Приёмка и размещение" id="BP1">
      <documentation>Сверка поставки, подтверждение принятого количества и размещение.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Инвентаризация" id="BP3">
      <documentation>Пересчёт зоны и утверждение корректировки.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Комплектация и передача" id="BP2">
      <documentation>Складской этап BP-03. Подбор, упаковка и физическая передача.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Складское исполнение заказа" id="BS1">
      <documentation>Подготовленный товар передаётся получателю.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-71747defebde400388d9f548bd655c04" type="application">
    <element xsi:type="archimate:ApplicationService" name="Учёт поступлений" id="AS1">
      <documentation>Сервис WMS для регистрации фактической приёмки.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Учёт инвентаризации" id="AS7">
      <documentation>Сервис WMS для сверки и применения утверждённой корректировки.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="WMS" id="AC1">
      <documentation>IS-05. Центральный остаток, резерв и складские операции.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ERP" id="AC2">
      <documentation>IS-01. Товары, закупки и учётные заказы. В целевой модели читает текущий запас в WMS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Платформа IS-07" id="AC3">
      <documentation>Общая платформа API и событий. Показана в целевом обмене.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Адаптер Warehouse" id="AC4">
      <documentation>Преобразование контрактов и восстановимая публикация. Складская запись остаётся в WMS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Интернет-магазин" id="AC5">
      <documentation>IS-03. Заказ канала и запрос резерва.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BI" id="AC6">
      <documentation>IS-06 в кейсе. Получатель аналитических данных.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Управление заданием" id="AF2">
      <documentation>Проверка резерва, подбор и физическая передача.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Управление резервом" id="AF3">
      <documentation>Атомарная проверка доступности и запись резерва.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Доставка складских событий" id="AF4">
      <documentation>Читает подтверждённый журнал через интерфейс WMS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Исполнение задания" id="AS2">
      <documentation>Сервис WMS, который поддерживает складское исполнение.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Подтверждение резерва" id="AS3">
      <documentation>Бизнес-ответ WMS о результате резервирования.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Чтение журнала WMS" id="AS6">
      <documentation>Доступ к подтверждённым событиям через поддерживаемый интерфейс.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Предоставление записей журнала" id="AF6">
      <documentation>Возвращает подтверждённые факты без доступа адаптера к таблицам WMS.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Центральный остаток" id="DO1">
      <documentation>Остаток и доступность по товару на центральном складе.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Задание и отгрузка" id="DO2">
      <documentation>Задание, состояние исполнения и подтверждение передачи.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Резерв заказа" id="DO4">
      <documentation>Связь orderId и reservationId, количество, статус, версия.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Журнал фактов WMS" id="DO5">
      <documentation>Запись вместе с изменением или поддерживаемый журнал с восстановимым курсором.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-d0e636bc1e5b4c0d85368b9ea8d8ea6d" type="technology">
    <element xsi:type="archimate:Node" name="Узел WMS на VM" id="N1">
      <documentation>Поддерживаемая поставщиком вычислительная среда.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyFunction" name="Выполнение WMS" id="TF1">
      <documentation>Среда запуска и исполнения приложения WMS.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Среда выполнения WMS" id="TS1">
      <documentation>Технологический сервис, который обслуживает WMS.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-ee8dc7a2e34d4f11b3bf07af6aa0d847" type="motivation"/>
