@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 8
skinparam maxMessageSize 180
skinparam wrapWidth 180
skinparam backgroundColor white
!pragma layout smetana
left to right direction
title C2 Приложение WMS — UML Component To-Be
component "Warehouse Adapter\nвнешний к C2, IS-07" as Adapter #E2F0E9
package "C2 Приложение WMS" {
 component "Command Handler" as Handler
 component "Command Guard" as Guard
 component "Store Movement Service" as Store
 component "Store Sync Service" as Sync
 component "Stock & Reservation" as Stock
 component "Fulfillment & Transfer" as Exec
 component "Receiving & Inventory Control" as Receive
 component "Repository / Audit / Outbox" as Repo
 interface IWarehouseCommand
 interface IGuard
 interface IStoreMovement
 interface IStoreSync
 interface IStock
 interface IExecution
 interface IReceiving
 interface ITransaction
 Handler - IWarehouseCommand
 Guard - IGuard
 Store - IStoreMovement
 Sync - IStoreSync
 Stock - IStock
 Exec - IExecution
 Receive - IReceiving
 Repo - ITransaction
 Handler ..> IGuard
 Handler ..> IStoreMovement
 Handler ..> IStoreSync
 Handler ..> IStock
 Handler ..> IExecution
 Handler ..> IReceiving
 Store ..> IStoreSync
 Store ..> IStock
 Store ..> ITransaction
 Sync ..> ITransaction
 Stock ..> ITransaction
 Exec ..> IStock
 Exec ..> ITransaction
 Receive ..> IStock
 Receive ..> ITransaction
}
database "C3 БД WMS\nвнешний к C2" as DB
Adapter ..> IWarehouseCommand
Repo --> DB : единая транзакционная граница
note bottom of Repo
Не отдельный микросервис.
Inbox, Stock, курсор, результат и outbox
фиксируются совместно при APPLIED.
end note
@enduml
