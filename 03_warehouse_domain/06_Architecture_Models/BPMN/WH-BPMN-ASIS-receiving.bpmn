<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WH-BPMN-ASIS-receiving" targetNamespace="https://retailmax.example/warehouse/models">
  <bpmn:message id="WH-BPMN-ASIS-receiving_message" name="Складское задание" />
  <bpmn:process id="WH-BPMN-ASIS-receiving_process" name="Приёмка As-Is" isExecutable="false">
    <bpmn:laneSet id="WH-BPMN-ASIS-receiving_lanes">
      <bpmn:lane id="WH-BPMN-ASIS-receiving_lane_0" name="Кладовщик / комплектовщик">
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-ASIS-receiving_lane_1" name="WMS и интеграции">
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-receiving_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-ASIS-receiving_lane_2" name="Начальник склада" />
    </bpmn:laneSet>
    <bpmn:startEvent id="WH-BPMN-ASIS-receiving_start" name="Товар прибыл">
      <bpmn:outgoing>WH-BPMN-ASIS-receiving_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="WH-BPMN-ASIS-receiving_accept" name="Принять товар">
      <bpmn:incoming>WH-BPMN-ASIS-receiving_flow_0</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-receiving_flow_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="WH-BPMN-ASIS-receiving_check" name="Проверить комплектность">
      <bpmn:incoming>WH-BPMN-ASIS-receiving_flow_1</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-receiving_flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="WH-BPMN-ASIS-receiving_place" name="Разместить вручную">
      <bpmn:incoming>WH-BPMN-ASIS-receiving_flow_2</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-receiving_flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="WH-BPMN-ASIS-receiving_record" name="Обновить информацию WMS">
      <bpmn:incoming>WH-BPMN-ASIS-receiving_flow_3</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-receiving_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="WH-BPMN-ASIS-receiving_end" name="Товар на хранении">
      <bpmn:incoming>WH-BPMN-ASIS-receiving_flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-receiving_flow_0" sourceRef="WH-BPMN-ASIS-receiving_start" targetRef="WH-BPMN-ASIS-receiving_accept" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-receiving_flow_1" sourceRef="WH-BPMN-ASIS-receiving_accept" targetRef="WH-BPMN-ASIS-receiving_check" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-receiving_flow_2" sourceRef="WH-BPMN-ASIS-receiving_check" targetRef="WH-BPMN-ASIS-receiving_place" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-receiving_flow_3" sourceRef="WH-BPMN-ASIS-receiving_place" targetRef="WH-BPMN-ASIS-receiving_record" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-receiving_flow_4" sourceRef="WH-BPMN-ASIS-receiving_record" targetRef="WH-BPMN-ASIS-receiving_end" />
  </bpmn:process>
  <bpmn:collaboration id="WH-BPMN-ASIS-receiving_collab">
    <bpmn:participant id="WH-BPMN-ASIS-receiving_pool" name="Warehouse — Приёмка As-Is" processRef="WH-BPMN-ASIS-receiving_process" />
    <bpmn:participant id="WH-BPMN-ASIS-receiving_external" name="Закупки / поставщик" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="WH-BPMN-ASIS-receiving_diagram">
    <bpmndi:BPMNPlane id="WH-BPMN-ASIS-receiving_plane" bpmnElement="WH-BPMN-ASIS-receiving_collab">
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_pool_di" bpmnElement="WH-BPMN-ASIS-receiving_pool" isHorizontal="true">
        <dc:Bounds x="50" y="110" width="1205" height="495" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_external_di" bpmnElement="WH-BPMN-ASIS-receiving_external" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1205" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_lane_0_di" bpmnElement="WH-BPMN-ASIS-receiving_lane_0" isHorizontal="true">
        <dc:Bounds x="80" y="110" width="1175" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_lane_1_di" bpmnElement="WH-BPMN-ASIS-receiving_lane_1" isHorizontal="true">
        <dc:Bounds x="80" y="275" width="1175" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_lane_2_di" bpmnElement="WH-BPMN-ASIS-receiving_lane_2" isHorizontal="true">
        <dc:Bounds x="80" y="440" width="1175" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_start_di" bpmnElement="WH-BPMN-ASIS-receiving_start">
        <dc:Bounds x="232.0" y="162.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="185.0" y="204.0" width="130" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_accept_di" bpmnElement="WH-BPMN-ASIS-receiving_accept">
        <dc:Bounds x="355.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_check_di" bpmnElement="WH-BPMN-ASIS-receiving_check">
        <dc:Bounds x="530.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_place_di" bpmnElement="WH-BPMN-ASIS-receiving_place">
        <dc:Bounds x="705.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_record_di" bpmnElement="WH-BPMN-ASIS-receiving_record">
        <dc:Bounds x="880.0" y="305.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-receiving_end_di" bpmnElement="WH-BPMN-ASIS-receiving_end">
        <dc:Bounds x="1107.0" y="327.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060.0" y="369.0" width="130" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-receiving_flow_di_0" bpmnElement="WH-BPMN-ASIS-receiving_flow_0">
        <di:waypoint x="268.0" y="180.0" />
        <di:waypoint x="355.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-receiving_flow_di_1" bpmnElement="WH-BPMN-ASIS-receiving_flow_1">
        <di:waypoint x="495.0" y="180.0" />
        <di:waypoint x="530.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-receiving_flow_di_2" bpmnElement="WH-BPMN-ASIS-receiving_flow_2">
        <di:waypoint x="670.0" y="180.0" />
        <di:waypoint x="705.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-receiving_flow_di_3" bpmnElement="WH-BPMN-ASIS-receiving_flow_3">
        <di:waypoint x="845.0" y="180.0" />
        <di:waypoint x="862.5" y="180.0" />
        <di:waypoint x="862.5" y="345.0" />
        <di:waypoint x="880.0" y="345.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-receiving_flow_di_4" bpmnElement="WH-BPMN-ASIS-receiving_flow_4">
        <di:waypoint x="1020.0" y="345.0" />
        <di:waypoint x="1107.0" y="345.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>