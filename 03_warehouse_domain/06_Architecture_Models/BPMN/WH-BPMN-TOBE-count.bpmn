<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WH-BPMN-TOBE-count" targetNamespace="https://retailmax.example/warehouse/models">
  <bpmn:message id="WH-BPMN-TOBE-count_message" name="Складское задание" />
  <bpmn:process id="WH-BPMN-TOBE-count_process" name="Инвентаризация To-Be" isExecutable="false">
    <bpmn:laneSet id="WH-BPMN-TOBE-count_lanes">
      <bpmn:lane id="WH-BPMN-TOBE-count_lane_0" name="Кладовщик / комплектовщик">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_count</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-count_lane_1" name="WMS и интеграции">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-count_lane_2" name="Начальник склада">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-count_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WH-BPMN-TOBE-count_start" name="Назначена проверка">
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WH-BPMN-TOBE-count_scope" name="Определить и закрыть зону для движений">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_0</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WH-BPMN-TOBE-count_snapshot" name="Зафиксировать учётный снимок">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_1</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="WH-BPMN-TOBE-count_count" name="Пересчитать товар">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_2</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WH-BPMN-TOBE-count_compare" name="Сравнить факт и снимок">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_3</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-count_gate" name="Есть расхождения?">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_4</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_5</bpmn:outgoing>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-count_approve" name="Проверить и утвердить корректировку">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_5</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WH-BPMN-TOBE-count_adjust" name="Записать корректировку и журнал события">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_6</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-count_merge" name="Результат зафиксирован">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_7</bpmn:incoming>
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_8</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-count_open" name="Открыть зону после сверки">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_9</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-count_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="WH-BPMN-TOBE-count_end" name="Проверка завершена">
      <bpmn:incoming>WH-BPMN-TOBE-count_flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_0" sourceRef="WH-BPMN-TOBE-count_start" targetRef="WH-BPMN-TOBE-count_scope" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_1" sourceRef="WH-BPMN-TOBE-count_scope" targetRef="WH-BPMN-TOBE-count_snapshot" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_2" sourceRef="WH-BPMN-TOBE-count_snapshot" targetRef="WH-BPMN-TOBE-count_count" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_3" sourceRef="WH-BPMN-TOBE-count_count" targetRef="WH-BPMN-TOBE-count_compare" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_4" sourceRef="WH-BPMN-TOBE-count_compare" targetRef="WH-BPMN-TOBE-count_gate" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_5" sourceRef="WH-BPMN-TOBE-count_gate" targetRef="WH-BPMN-TOBE-count_approve" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_6" sourceRef="WH-BPMN-TOBE-count_approve" targetRef="WH-BPMN-TOBE-count_adjust" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_7" sourceRef="WH-BPMN-TOBE-count_adjust" targetRef="WH-BPMN-TOBE-count_merge" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_8" sourceRef="WH-BPMN-TOBE-count_gate" targetRef="WH-BPMN-TOBE-count_merge" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_9" sourceRef="WH-BPMN-TOBE-count_merge" targetRef="WH-BPMN-TOBE-count_open" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-count_flow_10" sourceRef="WH-BPMN-TOBE-count_open" targetRef="WH-BPMN-TOBE-count_end" />
  </bpmn:process>
  <bpmn:collaboration id="WH-BPMN-TOBE-count_collab">
    <bpmn:participant id="WH-BPMN-TOBE-count_pool" name="Warehouse — Инвентаризация To-Be" processRef="WH-BPMN-TOBE-count_process" />
    <bpmn:participant id="WH-BPMN-TOBE-count_external" name="Финансовый учёт / ERP" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="WH-BPMN-TOBE-count_diagram">
    <bpmndi:BPMNPlane id="WH-BPMN-TOBE-count_plane" bpmnElement="WH-BPMN-TOBE-count_collab">
