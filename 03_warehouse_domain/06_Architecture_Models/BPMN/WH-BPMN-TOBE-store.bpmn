<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WH_STORE" targetNamespace="https://retailmax.example/warehouse/1.2">
  <bpmn:process id="Store" name="Магазин: первичный журнал" isExecutable="false">
    <bpmn:startEvent id="S0" name="Физическая операция"/>
    <bpmn:userTask id="S1" name="Проверить документ и количество"/>
    <bpmn:serviceTask id="S2" name="Записать факт, копию и outbox атомарно"/>
    <bpmn:serviceTask id="S3" name="Передать через IS-07, прежние ID"/>
    <bpmn:receiveTask id="S4" name="Получить бизнес-результат WMS"/>
    <bpmn:exclusiveGateway id="S5" name="APPLIED?"/>
    <bpmn:serviceTask id="S6" name="Подтвердить границу локально"/>
    <bpmn:endEvent id="S7" name="Подтверждено"/>
    <bpmn:userTask id="S8" name="Сохранить ожидание или разобрать расхождение"/>
    <bpmn:endEvent id="S9" name="Ожидание / разбор"/>
    <bpmn:sequenceFlow id="Store_f0" sourceRef="S0" targetRef="S1"/>
    <bpmn:sequenceFlow id="Store_f1" sourceRef="S1" targetRef="S2"/>
    <bpmn:sequenceFlow id="Store_f2" sourceRef="S2" targetRef="S3"/>
    <bpmn:sequenceFlow id="Store_f3" sourceRef="S3" targetRef="S4"/>
    <bpmn:sequenceFlow id="Store_f4" sourceRef="S4" targetRef="S5"/>
    <bpmn:sequenceFlow id="Store_f5" sourceRef="S5" targetRef="S6" name="Да"/>
    <bpmn:sequenceFlow id="Store_f6" sourceRef="S6" targetRef="S7"/>
    <bpmn:sequenceFlow id="Store_f7" sourceRef="S5" targetRef="S8" name="Нет"/>
    <bpmn:sequenceFlow id="Store_f8" sourceRef="S8" targetRef="S9"/>
  </bpmn:process>
  <bpmn:process id="WMS" name="WMS: подтверждённый учёт" isExecutable="false">
    <bpmn:startEvent id="W0" name="Получен факт STORE"/>
    <bpmn:serviceTask id="W1" name="Проверить права и повтор"/>
    <bpmn:serviceTask id="W2" name="Проверить порядок журнала и инварианты"/>
    <bpmn:exclusiveGateway id="W3" name="Можно применить?"/>
    <bpmn:serviceTask id="W4" name="Stock, граница, результат и outbox атомарно"/>
    <bpmn:sendTask id="W5" name="Подтвердить APPLIED через IS-07"/>
    <bpmn:endEvent id="W6" name="Факт применён"/>
    <bpmn:serviceTask id="W7" name="Сохранить pending / расхождение без сдвига границы"/>
    <bpmn:sendTask id="W8" name="Сообщить ожидание или расхождение"/>
    <bpmn:endEvent id="W9" name="Требуется догрузка / сверка"/>
    <bpmn:sequenceFlow id="WMS_f0" sourceRef="W0" targetRef="W1"/>
    <bpmn:sequenceFlow id="WMS_f1" sourceRef="W1" targetRef="W2"/>
    <bpmn:sequenceFlow id="WMS_f2" sourceRef="W2" targetRef="W3"/>
    <bpmn:sequenceFlow id="WMS_f3" sourceRef="W3" targetRef="W4" name="Да"/>
    <bpmn:sequenceFlow id="WMS_f4" sourceRef="W4" targetRef="W5"/>
    <bpmn:sequenceFlow id="WMS_f5" sourceRef="W5" targetRef="W6"/>
    <bpmn:sequenceFlow id="WMS_f6" sourceRef="W3" targetRef="W7" name="Нет"/>
    <bpmn:sequenceFlow id="WMS_f7" sourceRef="W7" targetRef="W8"/>
    <bpmn:sequenceFlow id="WMS_f8" sourceRef="W8" targetRef="W9"/>
  </bpmn:process>
  <bpmn:collaboration id="WH_STORE_COLLAB">
    <bpmn:participant id="POOL_Store" name="Магазин: первичный журнал" processRef="Store"/>
    <bpmn:participant id="POOL_WMS" name="WMS: подтверждённый учёт" processRef="WMS"/>
    <bpmn:messageFlow id="M1" sourceRef="S3" targetRef="W0" name="Движение через IS-07"/>
    <bpmn:messageFlow id="M2" sourceRef="W5" targetRef="S4" name="APPLIED через IS-07"/>
    <bpmn:messageFlow id="M3" sourceRef="W8" targetRef="S4" name="Исключение / IS-07"/>
  </bpmn:collaboration>
