<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WH-BPMN-TOBE-fulfillment" targetNamespace="https://retailmax.example/warehouse/models">
  <bpmn:message id="WH-BPMN-TOBE-fulfillment_message" name="Складское задание" />
  <bpmn:process id="WH-BPMN-TOBE-fulfillment_process" name="Исполнение заказа To-Be" isExecutable="false">
    <bpmn:laneSet id="WH-BPMN-TOBE-fulfillment_lanes">
      <bpmn:lane id="WH-BPMN-TOBE-fulfillment_lane_0" name="Кладовщик / комплектовщик">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_qty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_hand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-fulfillment_lane_1" name="WMS и интеграции">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-fulfillment_lane_2" name="Начальник склада">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_endno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-fulfillment_endex</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WH-BPMN-TOBE-fulfillment_start" name="Получено задание">
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WH-BPMN-TOBE-fulfillment_message_def" messageRef="WH-BPMN-TOBE-fulfillment_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="WH-BPMN-TOBE-fulfillment_validate" name="Проверить резерв и уникальность задания">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_0</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-fulfillment_gate" name="Резерв действителен?">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_1</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_2</bpmn:outgoing>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-fulfillment_reject" name="Разобрать отказ и уведомить владельца">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_2</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="WH-BPMN-TOBE-fulfillment_endno" name="Задание не принято">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="WH-BPMN-TOBE-fulfillment_allocate" name="Закрепить резерв и назначить маршрут">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_4</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="WH-BPMN-TOBE-fulfillment_pick" name="Подобрать и проверить строки">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_5</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-fulfillment_qty" name="Подбор полный?">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_6</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_7</bpmn:outgoing>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-fulfillment_short" name="Зафиксировать недостачу и уведомить владельца">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_7</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="WH-BPMN-TOBE-fulfillment_endex" name="Задание в исключении">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="WH-BPMN-TOBE-fulfillment_pack" name="Упаковать и подтвердить готовность">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_9</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="WH-BPMN-TOBE-fulfillment_hand" name="Подтвердить физическую передачу">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_10</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WH-BPMN-TOBE-fulfillment_commit" name="Исполнить резерв, списать запас и записать событие">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_11</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="WH-BPMN-TOBE-fulfillment_publish" name="Передать результат ERP и каналам">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_12</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-fulfillment_flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="WH-BPMN-TOBE-fulfillment_end" name="Передача отражена">
      <bpmn:incoming>WH-BPMN-TOBE-fulfillment_flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_0" sourceRef="WH-BPMN-TOBE-fulfillment_start" targetRef="WH-BPMN-TOBE-fulfillment_validate" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_1" sourceRef="WH-BPMN-TOBE-fulfillment_validate" targetRef="WH-BPMN-TOBE-fulfillment_gate" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_2" sourceRef="WH-BPMN-TOBE-fulfillment_gate" targetRef="WH-BPMN-TOBE-fulfillment_reject" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_3" sourceRef="WH-BPMN-TOBE-fulfillment_reject" targetRef="WH-BPMN-TOBE-fulfillment_endno" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_4" sourceRef="WH-BPMN-TOBE-fulfillment_gate" targetRef="WH-BPMN-TOBE-fulfillment_allocate" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_5" sourceRef="WH-BPMN-TOBE-fulfillment_allocate" targetRef="WH-BPMN-TOBE-fulfillment_pick" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_6" sourceRef="WH-BPMN-TOBE-fulfillment_pick" targetRef="WH-BPMN-TOBE-fulfillment_qty" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_7" sourceRef="WH-BPMN-TOBE-fulfillment_qty" targetRef="WH-BPMN-TOBE-fulfillment_short" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_8" sourceRef="WH-BPMN-TOBE-fulfillment_short" targetRef="WH-BPMN-TOBE-fulfillment_endex" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_9" sourceRef="WH-BPMN-TOBE-fulfillment_qty" targetRef="WH-BPMN-TOBE-fulfillment_pack" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_10" sourceRef="WH-BPMN-TOBE-fulfillment_pack" targetRef="WH-BPMN-TOBE-fulfillment_hand" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_11" sourceRef="WH-BPMN-TOBE-fulfillment_hand" targetRef="WH-BPMN-TOBE-fulfillment_commit" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_12" sourceRef="WH-BPMN-TOBE-fulfillment_commit" targetRef="WH-BPMN-TOBE-fulfillment_publish" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-fulfillment_flow_13" sourceRef="WH-BPMN-TOBE-fulfillment_publish" targetRef="WH-BPMN-TOBE-fulfillment_end" />
  </bpmn:process>
  <bpmn:collaboration id="WH-BPMN-TOBE-fulfillment_collab">
    <bpmn:participant id="WH-BPMN-TOBE-fulfillment_pool" name="Warehouse — Исполнение заказа To-Be" processRef="WH-BPMN-TOBE-fulfillment_process" />
    <bpmn:participant id="WH-BPMN-TOBE-fulfillment_external" name="ERP / владелец заказа" />
    <bpmn:messageFlow id="WH-BPMN-TOBE-fulfillment_msg_in" name="Задание" sourceRef="WH-BPMN-TOBE-fulfillment_external" targetRef="WH-BPMN-TOBE-fulfillment_start" />
    <bpmn:messageFlow id="WH-BPMN-TOBE-fulfillment_msg_out" name="Результат / факт" sourceRef="WH-BPMN-TOBE-fulfillment_publish" targetRef="WH-BPMN-TOBE-fulfillment_external" />
  </bpmn:collaboration>
