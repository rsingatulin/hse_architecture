<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WH-BPMN-ASIS-fulfillment" targetNamespace="https://retailmax.example/warehouse/models">
  <bpmn:message id="WH-BPMN-ASIS-fulfillment_message" name="Складское задание" />
  <bpmn:process id="WH-BPMN-ASIS-fulfillment_process" name="Исполнение заказа As-Is" isExecutable="false">
    <bpmn:laneSet id="WH-BPMN-ASIS-fulfillment_lanes">
      <bpmn:lane id="WH-BPMN-ASIS-fulfillment_lane_0" name="Кладовщик / комплектовщик">
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-ASIS-fulfillment_lane_1" name="WMS и интеграции">
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_erp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-ASIS-fulfillment_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-ASIS-fulfillment_lane_2" name="Начальник склада" />
    </bpmn:laneSet>
    <bpmn:startEvent id="WH-BPMN-ASIS-fulfillment_start" name="Заказ поступил">
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WH-BPMN-ASIS-fulfillment_message_def" messageRef="WH-BPMN-ASIS-fulfillment_message" />
    </bpmn:startEvent>
    <bpmn:task id="WH-BPMN-ASIS-fulfillment_task" name="Сформировать задание">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_0</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="WH-BPMN-ASIS-fulfillment_pick" name="Собрать без оптимизации маршрута">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_1</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="WH-BPMN-ASIS-fulfillment_pack" name="Упаковать заказ">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_2</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="WH-BPMN-ASIS-fulfillment_handover" name="Передать магазину / доставке">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_3</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="WH-BPMN-ASIS-fulfillment_erp" name="Передать изменение запасов ERP">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_4</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-ASIS-fulfillment_flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="WH-BPMN-ASIS-fulfillment_end" name="Исполнение завершено">
      <bpmn:incoming>WH-BPMN-ASIS-fulfillment_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_0" sourceRef="WH-BPMN-ASIS-fulfillment_start" targetRef="WH-BPMN-ASIS-fulfillment_task" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_1" sourceRef="WH-BPMN-ASIS-fulfillment_task" targetRef="WH-BPMN-ASIS-fulfillment_pick" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_2" sourceRef="WH-BPMN-ASIS-fulfillment_pick" targetRef="WH-BPMN-ASIS-fulfillment_pack" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_3" sourceRef="WH-BPMN-ASIS-fulfillment_pack" targetRef="WH-BPMN-ASIS-fulfillment_handover" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_4" sourceRef="WH-BPMN-ASIS-fulfillment_handover" targetRef="WH-BPMN-ASIS-fulfillment_erp" />
    <bpmn:sequenceFlow id="WH-BPMN-ASIS-fulfillment_flow_5" sourceRef="WH-BPMN-ASIS-fulfillment_erp" targetRef="WH-BPMN-ASIS-fulfillment_end" />
  </bpmn:process>
  <bpmn:collaboration id="WH-BPMN-ASIS-fulfillment_collab">
    <bpmn:participant id="WH-BPMN-ASIS-fulfillment_pool" name="Warehouse — Исполнение заказа As-Is" processRef="WH-BPMN-ASIS-fulfillment_process" />
    <bpmn:participant id="WH-BPMN-ASIS-fulfillment_external" name="ERP" />
    <bpmn:messageFlow id="WH-BPMN-ASIS-fulfillment_msg_in" name="Задание" sourceRef="WH-BPMN-ASIS-fulfillment_external" targetRef="WH-BPMN-ASIS-fulfillment_start" />
    <bpmn:messageFlow id="WH-BPMN-ASIS-fulfillment_msg_out" name="Результат / факт" sourceRef="WH-BPMN-ASIS-fulfillment_erp" targetRef="WH-BPMN-ASIS-fulfillment_external" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="WH-BPMN-ASIS-fulfillment_diagram">
    <bpmndi:BPMNPlane id="WH-BPMN-ASIS-fulfillment_plane" bpmnElement="WH-BPMN-ASIS-fulfillment_collab">
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_pool_di" bpmnElement="WH-BPMN-ASIS-fulfillment_pool" isHorizontal="true">
        <dc:Bounds x="50" y="110" width="1380" height="495" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_external_di" bpmnElement="WH-BPMN-ASIS-fulfillment_external" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_lane_0_di" bpmnElement="WH-BPMN-ASIS-fulfillment_lane_0" isHorizontal="true">
        <dc:Bounds x="80" y="110" width="1350" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_lane_1_di" bpmnElement="WH-BPMN-ASIS-fulfillment_lane_1" isHorizontal="true">
        <dc:Bounds x="80" y="275" width="1350" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_lane_2_di" bpmnElement="WH-BPMN-ASIS-fulfillment_lane_2" isHorizontal="true">
        <dc:Bounds x="80" y="440" width="1350" height="165" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_start_di" bpmnElement="WH-BPMN-ASIS-fulfillment_start">
        <dc:Bounds x="232.0" y="327.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="185.0" y="369.0" width="130" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_task_di" bpmnElement="WH-BPMN-ASIS-fulfillment_task">
        <dc:Bounds x="355.0" y="305.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_pick_di" bpmnElement="WH-BPMN-ASIS-fulfillment_pick">
        <dc:Bounds x="530.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_pack_di" bpmnElement="WH-BPMN-ASIS-fulfillment_pack">
        <dc:Bounds x="705.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_handover_di" bpmnElement="WH-BPMN-ASIS-fulfillment_handover">
        <dc:Bounds x="880.0" y="140.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_erp_di" bpmnElement="WH-BPMN-ASIS-fulfillment_erp">
        <dc:Bounds x="1055.0" y="305.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WH-BPMN-ASIS-fulfillment_end_di" bpmnElement="WH-BPMN-ASIS-fulfillment_end">
        <dc:Bounds x="1282.0" y="327.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1235.0" y="369.0" width="130" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_0" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_0">
        <di:waypoint x="268.0" y="345.0" />
        <di:waypoint x="355.0" y="345.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_1" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_1">
        <di:waypoint x="495.0" y="345.0" />
        <di:waypoint x="512.5" y="345.0" />
        <di:waypoint x="512.5" y="180.0" />
        <di:waypoint x="530.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_2" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_2">
        <di:waypoint x="670.0" y="180.0" />
        <di:waypoint x="705.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_3" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_3">
        <di:waypoint x="845.0" y="180.0" />
        <di:waypoint x="880.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_4" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_4">
        <di:waypoint x="1020.0" y="180.0" />
        <di:waypoint x="1037.5" y="180.0" />
        <di:waypoint x="1037.5" y="345.0" />
        <di:waypoint x="1055.0" y="345.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_flow_di_5" bpmnElement="WH-BPMN-ASIS-fulfillment_flow_5">
        <di:waypoint x="1195.0" y="345.0" />
        <di:waypoint x="1282.0" y="345.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_msg_in_di" bpmnElement="WH-BPMN-ASIS-fulfillment_msg_in">
        <di:waypoint x="250.0" y="70" />
        <di:waypoint x="250.0" y="327.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-ASIS-fulfillment_msg_out_di" bpmnElement="WH-BPMN-ASIS-fulfillment_msg_out">
        <di:waypoint x="1125.0" y="305.0" />
        <di:waypoint x="1125.0" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>