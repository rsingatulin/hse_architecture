<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WH-BPMN-TOBE-receiving" targetNamespace="https://retailmax.example/warehouse/models">
  <bpmn:message id="WH-BPMN-TOBE-receiving_message" name="Складское задание" />
  <bpmn:process id="WH-BPMN-TOBE-receiving_process" name="Приёмка To-Be" isExecutable="false">
    <bpmn:laneSet id="WH-BPMN-TOBE-receiving_lanes">
      <bpmn:lane id="WH-BPMN-TOBE-receiving_lane_0" name="Кладовщик / комплектовщик">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_place</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-receiving_lane_1" name="WMS и интеграции">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="WH-BPMN-TOBE-receiving_lane_2" name="Начальник склада">
        <bpmn:flowNodeRef>WH-BPMN-TOBE-receiving_exception</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="WH-BPMN-TOBE-receiving_start" name="Товар прибыл">
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WH-BPMN-TOBE-receiving_verify" name="Сверить поставку и факт">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_0</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-receiving_gate" name="Есть расхождения?">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_1</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_2</bpmn:outgoing>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-receiving_exception" name="Зафиксировать и согласовать расхождения">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_2</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-receiving_merge" name="Принятые строки определены">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_3</bpmn:incoming>
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_4</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WH-BPMN-TOBE-receiving_positive" name="Есть принятое количество?">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_5</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_6</bpmn:outgoing>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WH-BPMN-TOBE-receiving_place" name="Разместить принятое по правилам ячеек">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_6</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="WH-BPMN-TOBE-receiving_record" name="Записать приёмку, движение и журнал события">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_7</bpmn:incoming>
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_8</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="WH-BPMN-TOBE-receiving_publish" name="Передать подтверждённый факт">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_9</bpmn:incoming>
      <bpmn:outgoing>WH-BPMN-TOBE-receiving_flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="WH-BPMN-TOBE-receiving_end" name="Приёмка отражена">
      <bpmn:incoming>WH-BPMN-TOBE-receiving_flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_0" sourceRef="WH-BPMN-TOBE-receiving_start" targetRef="WH-BPMN-TOBE-receiving_verify" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_1" sourceRef="WH-BPMN-TOBE-receiving_verify" targetRef="WH-BPMN-TOBE-receiving_gate" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_2" sourceRef="WH-BPMN-TOBE-receiving_gate" targetRef="WH-BPMN-TOBE-receiving_exception" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_3" sourceRef="WH-BPMN-TOBE-receiving_gate" targetRef="WH-BPMN-TOBE-receiving_merge" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_4" sourceRef="WH-BPMN-TOBE-receiving_exception" targetRef="WH-BPMN-TOBE-receiving_merge" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_5" sourceRef="WH-BPMN-TOBE-receiving_merge" targetRef="WH-BPMN-TOBE-receiving_positive" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_6" sourceRef="WH-BPMN-TOBE-receiving_positive" targetRef="WH-BPMN-TOBE-receiving_place" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_7" sourceRef="WH-BPMN-TOBE-receiving_positive" targetRef="WH-BPMN-TOBE-receiving_record" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_8" sourceRef="WH-BPMN-TOBE-receiving_place" targetRef="WH-BPMN-TOBE-receiving_record" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_9" sourceRef="WH-BPMN-TOBE-receiving_record" targetRef="WH-BPMN-TOBE-receiving_publish" />
    <bpmn:sequenceFlow id="WH-BPMN-TOBE-receiving_flow_10" sourceRef="WH-BPMN-TOBE-receiving_publish" targetRef="WH-BPMN-TOBE-receiving_end" />
  </bpmn:process>
  <bpmn:collaboration id="WH-BPMN-TOBE-receiving_collab">
    <bpmn:participant id="WH-BPMN-TOBE-receiving_pool" name="Warehouse — Приёмка To-Be" processRef="WH-BPMN-TOBE-receiving_process" />
    <bpmn:participant id="WH-BPMN-TOBE-receiving_external" name="ERP / закупки" />
    <bpmn:messageFlow id="WH-BPMN-TOBE-receiving_msg_out" name="Результат / факт" sourceRef="WH-BPMN-TOBE-receiving_publish" targetRef="WH-BPMN-TOBE-receiving_external" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="WH-BPMN-TOBE-receiving_diagram">
    <bpmndi:BPMNPlane id="WH-BPMN-TOBE-receiving_plane" bpmnElement="WH-BPMN-TOBE-receiving_collab">
