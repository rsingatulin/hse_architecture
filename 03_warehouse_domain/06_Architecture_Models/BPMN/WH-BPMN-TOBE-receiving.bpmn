        <di:waypoint x="268.0" y="180.0" />
        <di:waypoint x="355.0" y="180.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="WH-BPMN-TOBE-receiving_flow_di_1" bpmnElement="WH-BPMN-TOBE-receiving_flow_1">
        <di:waypoint x="495.0" y="180.0" />
        <di:waypoint x="575.0" y="180.0" />
      </bpmndi:BPMNEdge>
