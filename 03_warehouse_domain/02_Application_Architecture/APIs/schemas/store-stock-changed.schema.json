{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "warehouse.store-stock.changed.v1 — proposed payload",
  "type": "object",
  "required": ["productId", "storeId", "locationId", "locationType", "unitCode", "onHand", "reserved", "blocked", "available", "asOf", "journalId", "appliedThroughSequence"],
  "properties": {
    "productId": {"type": "string", "minLength": 1},
    "storeId": {"type": "string", "minLength": 1},
    "locationId": {"type": "string", "minLength": 1},
    "locationType": {"const": "STORE"},
    "unitCode": {"type": "string", "minLength": 1},
    "onHand": {"$ref": "#/$defs/quantity"},
    "reserved": {"$ref": "#/$defs/quantity"},
    "blocked": {"$ref": "#/$defs/quantity"},
    "available": {"$ref": "#/$defs/quantity"},
    "asOf": {"type": "string", "format": "date-time"},
    "journalId": {"type": "string", "minLength": 1},
    "appliedThroughSequence": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  },
  "$comment": "WMS-confirmed full snapshot; aggregateType=StoreStock, aggregateId=locationId:productId. available = onHand - reserved - blocked >= 0. Freshness is determined together with warehouse.store-sync.changed.v1; old asOf alone does not imply disconnection. The snapshot and appliedThroughSequence share one boundary. This does not authorize online reservations of STORE stock.",
  "additionalProperties": true
}
