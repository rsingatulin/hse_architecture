<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BP04" targetNamespace="https://retailmax.example/bpmn" exporter="RetailMax architecture team" exporterVersion="As-Is 1.1">
  <message id="Message_Browse" name="Запрос каталога" />
  <message id="Message_Availability" name="Доступность по данным сайта" />
  <message id="Message_PaidOrder" name="Оформленный заказ и сведения об оплате" />
  <message id="Message_Issue" name="Проблема исполнения заказа" />
  <message id="Message_CustomerData" name="Данные клиента, заказа или покупки" />
  <message id="Message_Dispatch" name="Заказ и задание на доставку" />
  <message id="Message_Goods" name="Товар передан покупателю" />
  <message id="Message_Delivered" name="Подтверждение доставки" />
  <error id="Error_Exchange" name="Сбой передачи / обработки данных" errorCode="EXCHANGE_FAILURE" />
  <collaboration id="Collaboration_BP04">
    <participant id="Participant_Buyer" name="Покупатель" processRef="Process_Buyer" />
    <participant id="Participant_RetailMax" name="RetailMax · исполнение интернет-заказа" processRef="Process_RetailMax" />
    <participant id="Participant_CRM" name="CRM · отдельный обмен данными [A3]" processRef="Process_CRM" />
    <participant id="Participant_Delivery" name="Служба доставки" processRef="Process_Delivery" />
    <messageFlow id="MessageFlow_Browse" sourceRef="Buyer_Browse" targetRef="Web_Browse" messageRef="Message_Browse" name="Запрос" />
    <messageFlow id="MessageFlow_Availability" sourceRef="Web_Reply" targetRef="Buyer_Availability" messageRef="Message_Availability" name="Данные сайта" />
    <messageFlow id="MessageFlow_Order" sourceRef="Buyer_SendOrder" targetRef="Order_Start" messageRef="Message_PaidOrder" name="Заказ / оплата" />
    <messageFlow id="MessageFlow_CRM_Order" sourceRef="Order_CRM" targetRef="CRM_Start" messageRef="Message_CustomerData" name="Клиент / заказ" />
    <messageFlow id="MessageFlow_CRM_Purchase" sourceRef="Order_PurchaseCRM" targetRef="CRM_Start" messageRef="Message_CustomerData" name="История покупки" />
    <messageFlow id="MessageFlow_Dispatch" sourceRef="WH_Dispatch" targetRef="Delivery_Start" messageRef="Message_Dispatch" name="Сведения / задание" />
    <messageFlow id="MessageFlow_Delivered" sourceRef="Delivery_Confirm" targetRef="Order_Delivered" messageRef="Message_Delivered" name="Подтверждение" />
    <messageFlow id="MessageFlow_Goods" sourceRef="Delivery_Buyer" targetRef="Buyer_Received" messageRef="Message_Goods" name="Подтверждение передачи товара" />
    <messageFlow id="MessageFlow_Issue" sourceRef="Notify_Issue" targetRef="Buyer_Issue" messageRef="Message_Issue" name="Проблема исполнения" />
  </collaboration>
  <process id="Process_Buyer" name="Действия покупателя" isExecutable="false">
    <startEvent id="Buyer_Start" name="Возникла потребность">
      <outgoing>Buyer_Flow_1</outgoing>
    </startEvent>
    <userTask id="Buyer_Select" name="Выбрать товар на сайте">
      <incoming>Buyer_Flow_1</incoming>
      <outgoing>Buyer_Flow_2</outgoing>
    </userTask>
    <sendTask id="Buyer_Browse" name="Запросить наличие товара" messageRef="Message_Browse">
      <incoming>Buyer_Flow_2</incoming>
      <outgoing>Buyer_Flow_3</outgoing>
    </sendTask>
    <intermediateCatchEvent id="Buyer_Availability" name="Получены данные сайта">
      <incoming>Buyer_Flow_3</incoming>
      <outgoing>Buyer_Flow_4</outgoing>
      <messageEventDefinition id="Buyer_Availability_Message" messageRef="Message_Availability" />
    </intermediateCatchEvent>
    <exclusiveGateway id="Buyer_Available" name="Доступен по данным сайта?">
      <incoming>Buyer_Flow_4</incoming>
      <outgoing>Buyer_Flow_Available</outgoing>
      <outgoing>Buyer_Flow_Unavailable</outgoing>
    </exclusiveGateway>
    <endEvent id="Buyer_NoStock" name="Покупка не оформлена">
      <incoming>Buyer_Flow_Unavailable</incoming>
    </endEvent>
    <userTask id="Buyer_Create" name="Оформить заказ">
      <incoming>Buyer_Flow_Available</incoming>
      <outgoing>Buyer_Flow_6</outgoing>
    </userTask>
    <userTask id="Buyer_Auth" name="Зарегистрироваться / авторизоваться">
      <incoming>Buyer_Flow_6</incoming>
      <outgoing>Buyer_Flow_7</outgoing>
    </userTask>
    <userTask id="Buyer_Pay" name="Оплатить заказ">
      <incoming>Buyer_Flow_7</incoming>
      <outgoing>Buyer_Flow_8</outgoing>
    </userTask>
    <exclusiveGateway id="Buyer_Payment" name="Оплата успешна? [A4]">
      <incoming>Buyer_Flow_8</incoming>
      <outgoing>Buyer_Flow_Paid</outgoing>
      <outgoing>Buyer_Flow_NotPaid</outgoing>
    </exclusiveGateway>
    <endEvent id="Buyer_NotPaid" name="Заказ не передан на исполнение">
      <incoming>Buyer_Flow_NotPaid</incoming>
    </endEvent>
    <sendTask id="Buyer_SendOrder" name="Передать оформленный заказ и оплату" messageRef="Message_PaidOrder">
      <incoming>Buyer_Flow_Paid</incoming>
      <outgoing>Buyer_Flow_10</outgoing>
    </sendTask>
    <eventBasedGateway id="Buyer_Wait" name="Ожидать товар или сообщение о проблеме">
      <incoming>Buyer_Flow_10</incoming>
      <outgoing>Buyer_Flow_Goods</outgoing>
      <outgoing>Buyer_Flow_Issue</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Buyer_Received" name="Получить товар">
      <incoming>Buyer_Flow_Goods</incoming>
      <outgoing>Buyer_Flow_13</outgoing>
      <messageEventDefinition id="Buyer_Received_Message" messageRef="Message_Goods" />
    </intermediateCatchEvent>
    <endEvent id="Buyer_Done" name="Товар получен">
      <incoming>Buyer_Flow_13</incoming>
    </endEvent>
    <intermediateCatchEvent id="Buyer_Issue" name="Получено сообщение о проблеме">
      <incoming>Buyer_Flow_Issue</incoming>
      <outgoing>Buyer_Flow_14</outgoing>
      <messageEventDefinition id="Buyer_Issue_Message" messageRef="Message_Issue" />
    </intermediateCatchEvent>
    <userTask id="Buyer_Discuss" name="Обсудить дальнейшие действия с оператором [A1/A2]">
      <incoming>Buyer_Flow_14</incoming>
      <outgoing>Buyer_Flow_15</outgoing>
    </userTask>
    <endEvent id="Buyer_Exception" name="Дальнейшее решение вне модели">
      <incoming>Buyer_Flow_15</incoming>
    </endEvent>
    <sequenceFlow id="Buyer_Flow_1" sourceRef="Buyer_Start" targetRef="Buyer_Select" />
    <sequenceFlow id="Buyer_Flow_2" sourceRef="Buyer_Select" targetRef="Buyer_Browse" />
    <sequenceFlow id="Buyer_Flow_3" sourceRef="Buyer_Browse" targetRef="Buyer_Availability" />
    <sequenceFlow id="Buyer_Flow_4" sourceRef="Buyer_Availability" targetRef="Buyer_Available" />
    <sequenceFlow id="Buyer_Flow_6" sourceRef="Buyer_Create" targetRef="Buyer_Auth" />
    <sequenceFlow id="Buyer_Flow_7" sourceRef="Buyer_Auth" targetRef="Buyer_Pay" />
    <sequenceFlow id="Buyer_Flow_8" sourceRef="Buyer_Pay" targetRef="Buyer_Payment" />
    <sequenceFlow id="Buyer_Flow_10" sourceRef="Buyer_SendOrder" targetRef="Buyer_Wait" />
    <sequenceFlow id="Buyer_Flow_13" sourceRef="Buyer_Received" targetRef="Buyer_Done" />
    <sequenceFlow id="Buyer_Flow_14" sourceRef="Buyer_Issue" targetRef="Buyer_Discuss" />
    <sequenceFlow id="Buyer_Flow_15" sourceRef="Buyer_Discuss" targetRef="Buyer_Exception" />
    <sequenceFlow id="Buyer_Flow_Available" sourceRef="Buyer_Available" targetRef="Buyer_Create" name="Да" />
    <sequenceFlow id="Buyer_Flow_Unavailable" sourceRef="Buyer_Available" targetRef="Buyer_NoStock" name="Нет" />
    <sequenceFlow id="Buyer_Flow_Paid" sourceRef="Buyer_Payment" targetRef="Buyer_SendOrder" name="Да" />
    <sequenceFlow id="Buyer_Flow_NotPaid" sourceRef="Buyer_Payment" targetRef="Buyer_NotPaid" name="Нет" />
    <sequenceFlow id="Buyer_Flow_Goods" sourceRef="Buyer_Wait" targetRef="Buyer_Received" />
    <sequenceFlow id="Buyer_Flow_Issue" sourceRef="Buyer_Wait" targetRef="Buyer_Issue" />
  </process>
  <process id="Process_RetailMax" name="BP-04 Интернет-продажи As-Is" isExecutable="false">
    <documentation>As-Is по DOC-03, DOC-05 и EC-PRB-001. Детализация исключений A1/A2 и независимость обмена с CRM A3 — допущения для согласования; см. BP-04-internet-sales-as-is.md. Критерии успеха исполнения и обмена с CRM различаются. Модель не задаёт целевую интеграционную платформу, гарантированные повторы или правила возврата оплаты.</documentation>
    <laneSet id="Process_RetailMax_Lanes">
      <lane id="Lane_Web" name="Интернет-магазин">
        <flowNodeRef>Web_Browse</flowNodeRef>
        <flowNodeRef>Web_Show</flowNodeRef>
        <flowNodeRef>Web_Reply</flowNodeRef>
        <flowNodeRef>Web_Shown</flowNodeRef>
        <flowNodeRef>Order_Start</flowNodeRef>
        <flowNodeRef>Order_CRM</flowNodeRef>
        <flowNodeRef>Order_ERP</flowNodeRef>
        <flowNodeRef>Error_ERP</flowNodeRef>
        <flowNodeRef>Order_Delivered</flowNodeRef>
        <flowNodeRef>Order_PurchaseCRM</flowNodeRef>
        <flowNodeRef>Order_Done</flowNodeRef>
      </lane>
      <lane id="Lane_ERP" name="ERP">
        <flowNodeRef>ERP_Register</flowNodeRef>
        <flowNodeRef>ERP_WMS</flowNodeRef>
        <flowNodeRef>Error_WMS</flowNodeRef>
      </lane>
      <lane id="Lane_Warehouse" name="Склад / WMS">
        <flowNodeRef>WMS_Receive</flowNodeRef>
        <flowNodeRef>WH_Check</flowNodeRef>
        <flowNodeRef>WH_Available</flowNodeRef>
        <flowNodeRef>WH_Pick</flowNodeRef>
        <flowNodeRef>WH_Dispatch</flowNodeRef>
      </lane>
      <lane id="Lane_Operator" name="Оператор / сопровождение">
        <flowNodeRef>Support_ERP</flowNodeRef>
        <flowNodeRef>Retry_ERP</flowNodeRef>
        <flowNodeRef>Support_WMS</flowNodeRef>
        <flowNodeRef>Retry_WMS</flowNodeRef>
        <flowNodeRef>Support_Stock</flowNodeRef>
        <flowNodeRef>Notify_Issue</flowNodeRef>
        <flowNodeRef>Order_Exception</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Web_Browse" name="Запрос наличия">
      <outgoing>Web_Flow_1</outgoing>
      <messageEventDefinition id="Web_Browse_Message" messageRef="Message_Browse" />
    </startEvent>
    <serviceTask id="Web_Show" name="Показать наличие из копии данных">
      <incoming>Web_Flow_1</incoming>
      <outgoing>Web_Flow_2</outgoing>
    </serviceTask>
    <sendTask id="Web_Reply" name="Вернуть доступность по данным сайта" messageRef="Message_Availability">
      <incoming>Web_Flow_2</incoming>
      <outgoing>Web_Flow_3</outgoing>
    </sendTask>
    <endEvent id="Web_Shown" name="Данные показаны">
      <incoming>Web_Flow_3</incoming>
    </endEvent>
    <sequenceFlow id="Web_Flow_1" sourceRef="Web_Browse" targetRef="Web_Show" />
    <sequenceFlow id="Web_Flow_2" sourceRef="Web_Show" targetRef="Web_Reply" />
    <sequenceFlow id="Web_Flow_3" sourceRef="Web_Reply" targetRef="Web_Shown" />
    <dataStoreReference id="Data_Catalog" name="Копия каталога и остатков ERP" />
    <startEvent id="Order_Start" name="Получен оформленный / оплаченный заказ">
      <outgoing>Order_Flow_1</outgoing>
      <messageEventDefinition id="Order_Start_Message" messageRef="Message_PaidOrder" />
    </startEvent>
    <sendTask id="Order_CRM" name="Передать данные клиента и заказа в CRM [A3]" messageRef="Message_CustomerData">
      <incoming>Order_Flow_1</incoming>
      <outgoing>Order_Flow_2</outgoing>
    </sendTask>
    <serviceTask id="Order_ERP" name="Передать заказ в ERP">
      <incoming>Order_Flow_2</incoming>
      <incoming>Retry_Flow_ERP</incoming>
      <outgoing>Order_Flow_3</outgoing>
    </serviceTask>
    <boundaryEvent id="Error_ERP" name="Сбой обмена" attachedToRef="Order_ERP" cancelActivity="true">
      <outgoing>Exception_ERP</outgoing>
      <errorEventDefinition id="Error_ERP_Error" errorRef="Error_Exchange" />
    </boundaryEvent>
    <serviceTask id="ERP_Register" name="Зарегистрировать заказ в ERP">
      <incoming>Order_Flow_3</incoming>
      <outgoing>Order_Flow_4</outgoing>
    </serviceTask>
    <serviceTask id="ERP_WMS" name="Передать задание на комплектацию в WMS">
      <incoming>Order_Flow_4</incoming>
      <incoming>Retry_Flow_WMS</incoming>
      <outgoing>Order_Flow_5</outgoing>
    </serviceTask>
    <boundaryEvent id="Error_WMS" name="Сбой обмена" attachedToRef="ERP_WMS" cancelActivity="true">
      <outgoing>Exception_WMS</outgoing>
      <errorEventDefinition id="Error_WMS_Error" errorRef="Error_Exchange" />
    </boundaryEvent>
    <serviceTask id="WMS_Receive" name="Получить задание в WMS">
      <incoming>Order_Flow_5</incoming>
      <outgoing>Order_Flow_6</outgoing>
    </serviceTask>
    <userTask id="WH_Check" name="Уточнить фактическое наличие при комплектации [A1]">
      <incoming>Order_Flow_6</incoming>
      <outgoing>Order_Flow_7</outgoing>
    </userTask>
    <exclusiveGateway id="WH_Available" name="Можно скомплектовать? [A1]">
      <incoming>Order_Flow_7</incoming>
      <outgoing>Order_Flow_8</outgoing>
      <outgoing>Stock_Unavailable</outgoing>
    </exclusiveGateway>
    <userTask id="WH_Pick" name="Скомплектовать заказ с использованием WMS">
      <incoming>Order_Flow_8</incoming>
      <outgoing>Order_Flow_9</outgoing>
    </userTask>
    <sendTask id="WH_Dispatch" name="Передать сведения об отгрузке и доставке" messageRef="Message_Dispatch">
      <incoming>Order_Flow_9</incoming>
      <outgoing>Order_Flow_10</outgoing>
    </sendTask>
    <intermediateCatchEvent id="Order_Delivered" name="Получено подтверждение доставки">
      <incoming>Order_Flow_10</incoming>
      <outgoing>Order_Flow_11</outgoing>
      <messageEventDefinition id="Order_Delivered_Message" messageRef="Message_Delivered" />
    </intermediateCatchEvent>
    <sendTask id="Order_PurchaseCRM" name="Передать историю покупки в CRM [A3]" messageRef="Message_CustomerData">
      <incoming>Order_Flow_11</incoming>
      <outgoing>Order_Flow_12</outgoing>
    </sendTask>
    <endEvent id="Order_Done" name="Исполнение заказа завершено">
      <incoming>Order_Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Order_Flow_1" sourceRef="Order_Start" targetRef="Order_CRM" />
    <sequenceFlow id="Order_Flow_2" sourceRef="Order_CRM" targetRef="Order_ERP" />
    <sequenceFlow id="Order_Flow_3" sourceRef="Order_ERP" targetRef="ERP_Register" />
    <sequenceFlow id="Order_Flow_4" sourceRef="ERP_Register" targetRef="ERP_WMS" />
    <sequenceFlow id="Order_Flow_5" sourceRef="ERP_WMS" targetRef="WMS_Receive" />
    <sequenceFlow id="Order_Flow_6" sourceRef="WMS_Receive" targetRef="WH_Check" />
    <sequenceFlow id="Order_Flow_7" sourceRef="WH_Check" targetRef="WH_Available" />
    <sequenceFlow id="Order_Flow_8" sourceRef="WH_Available" targetRef="WH_Pick" name="Да" />
    <sequenceFlow id="Order_Flow_9" sourceRef="WH_Pick" targetRef="WH_Dispatch" />
    <sequenceFlow id="Order_Flow_10" sourceRef="WH_Dispatch" targetRef="Order_Delivered" />
    <sequenceFlow id="Order_Flow_11" sourceRef="Order_Delivered" targetRef="Order_PurchaseCRM" />
    <sequenceFlow id="Order_Flow_12" sourceRef="Order_PurchaseCRM" targetRef="Order_Done" />
    <userTask id="Support_ERP" name="Разобрать сбой передачи заказа вручную [A2]">
      <incoming>Exception_ERP</incoming>
      <outgoing>Exception_Check_ERP</outgoing>
    </userTask>
    <exclusiveGateway id="Retry_ERP" name="Передачу можно восстановить? [A2]">
      <incoming>Exception_Check_ERP</incoming>
      <outgoing>Retry_Flow_ERP</outgoing>
      <outgoing>ERP_Unresolved</outgoing>
    </exclusiveGateway>
    <userTask id="Support_WMS" name="Разобрать сбой передачи задания вручную [A2]">
      <incoming>Exception_WMS</incoming>
      <outgoing>Exception_Check_WMS</outgoing>
    </userTask>
    <exclusiveGateway id="Retry_WMS" name="Передачу можно восстановить? [A2]">
      <incoming>Exception_Check_WMS</incoming>
      <outgoing>Retry_Flow_WMS</outgoing>
      <outgoing>WMS_Unresolved</outgoing>
    </exclusiveGateway>
    <userTask id="Support_Stock" name="Уточнить расхождение остатков и варианты исполнения [A1]">
      <incoming>Stock_Unavailable</incoming>
      <outgoing>Stock_Issue</outgoing>
    </userTask>
    <sendTask id="Notify_Issue" name="Сообщить о проблеме исполнения [A1/A2]" messageRef="Message_Issue">
      <incoming>ERP_Unresolved</incoming>
      <incoming>WMS_Unresolved</incoming>
      <incoming>Stock_Issue</incoming>
      <outgoing>Issue_End</outgoing>
    </sendTask>
    <endEvent id="Order_Exception" name="Заказ передан на ручное урегулирование">
      <incoming>Issue_End</incoming>
    </endEvent>
    <sequenceFlow id="Exception_ERP" sourceRef="Error_ERP" targetRef="Support_ERP" />
    <sequenceFlow id="Exception_WMS" sourceRef="Error_WMS" targetRef="Support_WMS" />
    <sequenceFlow id="Exception_Check_ERP" sourceRef="Support_ERP" targetRef="Retry_ERP" />
    <sequenceFlow id="Exception_Check_WMS" sourceRef="Support_WMS" targetRef="Retry_WMS" />
    <sequenceFlow id="Retry_Flow_ERP" sourceRef="Retry_ERP" targetRef="Order_ERP" name="Да · вручную" />
    <sequenceFlow id="Retry_Flow_WMS" sourceRef="Retry_WMS" targetRef="ERP_WMS" name="Да · вручную" />
    <sequenceFlow id="ERP_Unresolved" sourceRef="Retry_ERP" targetRef="Notify_Issue" name="Нет" />
    <sequenceFlow id="WMS_Unresolved" sourceRef="Retry_WMS" targetRef="Notify_Issue" name="Нет" />
    <sequenceFlow id="Stock_Unavailable" sourceRef="WH_Available" targetRef="Support_Stock" name="Нет" />
    <sequenceFlow id="Stock_Issue" sourceRef="Support_Stock" targetRef="Notify_Issue" />
    <sequenceFlow id="Issue_End" sourceRef="Notify_Issue" targetRef="Order_Exception" />
    <association id="Catalog_Association" sourceRef="Data_Catalog" targetRef="Web_Show" associationDirection="One" />
    <textAnnotation id="Note_Catalog">
      <text>EC-P-01 · DOC-05 / INT-03
Обновление каждые 15 минут.
Показанный остаток может быть устаревшим.</text>
    </textAnnotation>
    <textAnnotation id="Note_Peak">
      <text>EC-P-03 · DOC-11, интервью 5
В акции сайт замедляется.
Нет фиксированного времени ожидания.</text>
    </textAnnotation>
    <association id="Note_Peak_Association" sourceRef="Web_Show" targetRef="Note_Peak" associationDirection="None" />
    <textAnnotation id="Note_Duration">
      <text>EC-P-02 · DOC-10
Средняя обработка — 30 минут.
Границы замера не определены;
это не время физической доставки.</text>
    </textAnnotation>
    <association id="Note_Duration_Association" sourceRef="Order_ERP" targetRef="Note_Duration" associationDirection="None" />
    <textAnnotation id="Note_Integration">
      <text>EC-P-04 / EC-P-06
Задержки и ручной разбор обменов.
Каналы DOC-05 и DOC-16 расходятся;
точный механизм требует уточнения.</text>
    </textAnnotation>
    <association id="Note_Integration_Association" sourceRef="ERP_WMS" targetRef="Note_Integration" associationDirection="None" />
    <textAnnotation id="Note_Stock">
      <text>EC-P-01 · DOC-03/05
Сайт показал «доступен», но фактического товара не хватает.
[A1] Место выявления и урегулирование — допущение.</text>
    </textAnnotation>
    <association id="Note_Stock_Association" sourceRef="WH_Check" targetRef="Note_Stock" associationDirection="None" />
    <textAnnotation id="Note_Manual">
      <text>EC-P-06 · DOC-16
[A2] Ручное восстановление и возврат к сбойному шагу — детализация для согласования.
Автоматические повторы и возврат оплаты не утверждаются.</text>
    </textAnnotation>
  </process>
  <process id="Process_CRM" name="Передача клиентских данных и истории" isExecutable="false">
    <startEvent id="CRM_Start" name="Получены данные клиента / заказа / покупки">
      <outgoing>CRM_Flow_1</outgoing>
      <messageEventDefinition id="CRM_Start_Message" messageRef="Message_CustomerData" />
    </startEvent>
    <serviceTask id="CRM_Save" name="Сохранить данные в CRM">
      <incoming>CRM_Flow_1</incoming>
      <outgoing>CRM_Flow_2</outgoing>
    </serviceTask>
    <boundaryEvent id="CRM_Error" name="Сбой обмена" attachedToRef="CRM_Save" cancelActivity="true">
      <outgoing>CRM_Flow_Error</outgoing>
      <errorEventDefinition id="CRM_Error_Error" errorRef="Error_Exchange" />
    </boundaryEvent>
    <endEvent id="CRM_Done" name="Данные сохранены; возможен дубль">
      <incoming>CRM_Flow_2</incoming>
    </endEvent>
    <userTask id="CRM_Manual" name="Разобрать ошибку обмена вручную [A2/A3]">
      <incoming>CRM_Flow_Error</incoming>
      <outgoing>CRM_Flow_Unresolved</outgoing>
    </userTask>
    <endEvent id="CRM_Unresolved" name="Сбой CRM передан на разбор">
      <incoming>CRM_Flow_Unresolved</incoming>
    </endEvent>
    <sequenceFlow id="CRM_Flow_1" sourceRef="CRM_Start" targetRef="CRM_Save" />
    <sequenceFlow id="CRM_Flow_2" sourceRef="CRM_Save" targetRef="CRM_Done" />
    <sequenceFlow id="CRM_Flow_Error" sourceRef="CRM_Error" targetRef="CRM_Manual" />
    <sequenceFlow id="CRM_Flow_Unresolved" sourceRef="CRM_Manual" targetRef="CRM_Unresolved" />
    <textAnnotation id="Note_CRM">
      <text>EC-P-05 · DOC-05 / INT-04
Нет согласованного единого идентификатора;
возможны дубли карточек.
[A3] Независимость обмена требует подтверждения.</text>
    </textAnnotation>
    <association id="Note_CRM_Association" sourceRef="CRM_Save" targetRef="Note_CRM" associationDirection="None" />
  </process>
  <process id="Process_Delivery" name="Исполнение доставки" isExecutable="false">
    <startEvent id="Delivery_Start" name="Получен товар и задание">
      <outgoing>Delivery_Flow_1</outgoing>
      <messageEventDefinition id="Delivery_Start_Message" messageRef="Message_Dispatch" />
    </startEvent>
    <manualTask id="Delivery_Transport" name="Доставить и передать товар покупателю">
      <incoming>Delivery_Flow_1</incoming>
      <outgoing>Delivery_Flow_2</outgoing>
    </manualTask>
    <sendTask id="Delivery_Buyer" name="Подтвердить передачу товара покупателю" messageRef="Message_Goods">
      <incoming>Delivery_Flow_2</incoming>
      <outgoing>Delivery_Flow_3</outgoing>
    </sendTask>
    <sendTask id="Delivery_Confirm" name="Сообщить RetailMax о доставке" messageRef="Message_Delivered">
      <incoming>Delivery_Flow_3</incoming>
      <outgoing>Delivery_Flow_4</outgoing>
    </sendTask>
    <endEvent id="Delivery_Done" name="Доставка выполнена">
      <incoming>Delivery_Flow_4</incoming>
    </endEvent>
    <sequenceFlow id="Delivery_Flow_1" sourceRef="Delivery_Start" targetRef="Delivery_Transport" />
    <sequenceFlow id="Delivery_Flow_2" sourceRef="Delivery_Transport" targetRef="Delivery_Buyer" />
    <sequenceFlow id="Delivery_Flow_3" sourceRef="Delivery_Buyer" targetRef="Delivery_Confirm" />
    <sequenceFlow id="Delivery_Flow_4" sourceRef="Delivery_Confirm" targetRef="Delivery_Done" />
    <textAnnotation id="Note_Scope">
      <text>EC-P-07: суточные загрузки ERP/CRM → BI — отдельный процесс аналитики.
EC-P-08: выпуск функций и персонализация рассматриваются в архитектуре приложений.
Подтверждения доставки [A5] — детализация стыка, протокол не установлен.</text>
    </textAnnotation>
  </process>
