@startuml C4-EC-002-container
!pragma layout smetana
!include <C4/C4_Container>
skinparam backgroundColor white
LAYOUT_TOP_DOWN()
title C4 Container — IS-03 Интернет-магазин (As-Is)
Person(buyer, "Покупатель", "Работает с сайтом")
Person(operator, "Оператор интернет-магазина", "Сопровождает заказы")
System_Boundary(shop, "IS-03 Интернет-магазин — логическая реконструкция [A-C4-01]") {
  Container(web, "Web Application", "Серверное веб-приложение; стек не указан", "Каталог, корзина, регистрация, оплата, оформление и статусы. Выбранный контейнер")
  ContainerDb(db, "Shop Data Store", "Хранилище; СУБД и физическая топология не указаны", "Копия каталога и остатков, корзины, заказы, регистрационные данные [A-C4-01]")
}
System_Ext(erp, "IS-01 ERP", "Каталог, цены и регистрация заказов")
System_Ext(crm, "IS-02 CRM", "Клиенты и история заказов")
System_Ext(ip, "IS-07 Integration Platform", "Часть существующих обменов; маршруты IS-03 не уточнены [A-C4-02]")
System_Ext(pay, "Внешняя система оплаты [A-C4-03]", "Протокол и провайдер не указаны")
Rel(buyer, web, "Просмотр и оформление заказа", "Web; транспорт не указан")
Rel(operator, web, "Сопровождение заказа", "Web; транспорт не указан")
Rel(web, db, "Читает и сохраняет данные", "Доступ к данным; протокол не указан")
Rel(web, erp, "Каталог каждые 15 минут; передача заказа", "REST API, INT-03 / DOC-05")
Rel(web, crm, "Клиент и история заказов", "REST API, INT-04 / DOC-05")
Rel(web, ip, "Существующий обмен по обзорной схеме", "API; маршруты неизвестны [A-C4-02]")
Rel(web, pay, "Оплата и ее результат", "Протокол неизвестен [A-C4-03]")
SHOW_LEGEND()
footer Один контейнер приложения и одно логическое хранилище. Отдельные сервисы и стек не подтверждены
@enduml
