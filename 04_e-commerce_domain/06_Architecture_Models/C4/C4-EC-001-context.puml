@startuml C4-EC-001-context
!pragma layout smetana
!include <C4/C4_Context>
skinparam backgroundColor white
LAYOUT_TOP_DOWN()
title C4 Context — интернет-продажи RetailMax (As-Is)
Person(buyer, "Покупатель", "Выбирает товары, оформляет и оплачивает заказ")
Person(operator, "Оператор интернет-магазина", "Сопровождает заказы, вручную разбирает ошибки [BPMN A2]")
System(shop, "IS-03 Интернет-магазин", "Каталог, регистрация, оформление заказа, оплата и просмотр статуса")
System_Ext(erp, "IS-01 ERP", "Каталог, цены, учет заказов и финансов")
System_Ext(crm, "IS-02 CRM", "Клиентская база и история покупок")
System_Ext(ip, "IS-07 Integration Platform", "Существующие обмены. Точные маршруты IS-03 не определены [A-C4-02]")
System_Ext(wms, "IS-05 WMS", "Складские операции и комплектация")
System_Ext(pay, "Внешняя система оплаты [A-C4-03]", "Условный участник: механизм оплаты не указан в DOC-03")
System_Ext(delivery, "Служба доставки", "Получает сведения об отгрузке и доставляет товар")
Rel(buyer, shop, "Выбирает товар, оформляет и оплачивает заказ")
Rel(operator, shop, "Сопровождает и вручную восстанавливает обработку")
Rel(erp, shop, "Передает каталог, цены и остатки каждые 15 минут (DOC-05)")
Rel(shop, erp, "Передает оформленные заказы и отмены (DOC-05)")
Rel(shop, crm, "Передает клиента и историю заказов (DOC-05)")
Rel(shop, ip, "Обменивается данными по обзорной схеме DOC-05 [A-C4-02]")
Rel(shop, pay, "Принимает результат оплаты [A-C4-03]")
Rel(erp, wms, "Передает задание после регистрации заказа")
Rel(wms, delivery, "Передает сведения об отгрузке. Товар передает склад")
Rel(delivery, buyer, "Доставляет товар")
SHOW_LEGEND()
footer ERP–WMS–доставка — окружение BP-04. В выбранном сценарии IS-03 не вызывает WMS напрямую
@enduml
