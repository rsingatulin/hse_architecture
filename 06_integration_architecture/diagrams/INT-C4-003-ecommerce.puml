@startuml INT-C4-003-ecommerce
!pragma layout smetana
!$LEGEND_TITLE_TEXT = "Условные обозначения"
!$PERSON_LEGEND_TEXT = "пользователь"
!$EXTERNAL_PERSON_LEGEND_TEXT = "внешний пользователь"
!$SYSTEM_LEGEND_TEXT = "система"
!$EXTERNAL_SYSTEM_LEGEND_TEXT = "внешняя система"
!$SYSTEM_BOUNDARY_TYPE = "система"
!$SYSTEM_BOUNDARY_LEGEND_TEXT = "граница системы"
!$CONTAINER_LEGEND_TEXT = "контейнер"
!$EXTERNAL_CONTAINER_LEGEND_TEXT = "внешний контейнер"
!$CONTAINER_BOUNDARY_TYPE = "контейнер"
!$CONTAINER_BOUNDARY_LEGEND_TEXT = "граница контейнера"
!$LEGEND_BOUNDARY_DASHED_INCL_COMA = "пунктир, "
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam backgroundColor white
title Целевая структура интернет-магазина\nINT-C4-003 · контейнеры C4 · проект 1.3
Person(buyer, "Покупатель", "Выбирает товары и оформляет заказ")
Person(operator, "Оператор", "Сопровождает заказы и разбирает проблемные ситуации")
System_Boundary(ec, "IS-03 — домен интернет-продаж") {
 Container(web, "Витрина / личный кабинет", "Веб-интерфейс", "Каталог, корзина, подтверждение цены, статус заказа")
 Container(app, "Приложение магазина", "Серверная часть", "Каталог, заказ, профиль и оплата; итог по ценам ERP и скидкам CRM, согласие покупателя")
 Container(worker, "Обработка обменов", "Фоновый обработчик", "Очередь отправки, журнал обработки, обновление локальных данных и статусов заказов по событиям")
 ContainerDb(db, "Данные интернет-магазина", "Собственное хранилище", "Заказы, подтверждённые цены ERP, скидки и суммы; связи идентификаторов, копии каталога и остатков")
}
System_Ext(ip, "IS-07 — общая платформа", "API, события и адаптеры; восстановление обмена после сбоев")
System_Ext(erp, "ERP", "Товары, цены и учёт заказов со скидками и итоговой суммой; создаёт задания для WMS")
System_Ext(wms, "WMS", "Резерв до оплаты, сохранение резерва после оплаты*, подбор и передача товара")
System_Ext(ret, "CRM / лояльность / рекомендации", "customerId, персональные скидки, бонусные операции и подборки товаров")
System_Ext(providers, "Оплата / доставка / коммуникации", "Провайдеры за адаптерами платформы")
Rel(buyer, web, "Пользуется", "HTTPS")
Rel(operator, web, "Обрабатывает заказы", "HTTPS / проверка роли")
Rel(web, app, "Действия пользователя", "API магазина")
Rel(app, db, "Сохранить заказ, цены, скидки и сообщения для отправки", "Локальная транзакция")
Rel(worker, db, "Обновить очереди, журнал обработки и локальные копии", "Локальная транзакция")
BiRel(app, ip, "Цены ERP, скидка CRM, профиль, резерв, оплата", "INT API-01–10/17–19/24/28")
BiRel(worker, ip, "Запросы на выполнение операций и их результаты", "Команды / события")
BiRel(ip, erp, "API-03: цены; API-10: заказ с применёнными скидками", "API / события")
BiRel(ip, wms, "Резервирование и исполнение заказа", "API / события")
BiRel(ip, ret, "API-28: персональная скидка; бонусы отдельно API-17/18", "API / события")
BiRel(ip, providers, "Запросы и проверенные уведомления о результатах", "API / адаптеры")
SHOW_LEGEND()
footer
* Сохранение резерва после оплаты (confirm-paid) — предлагаемое расширение. Серверные модули могут работать в одном приложении; платёжная
страница провайдера на схеме не показана.
end footer
@enduml
