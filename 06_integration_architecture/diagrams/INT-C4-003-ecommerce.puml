@startuml INT-C4-003-ecommerce
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam backgroundColor white
title Интернет-магазин — контейнеры To-Be\nINT-C4-003 · проект 1.1
Person(buyer, "Покупатель", "Выбор товара и оформление")
Person(operator, "Оператор", "Сопровождение и урегулирование")
System_Boundary(ec, "IS-03 — домен интернет-продаж") {
 Container(web, "Витрина / кабинет", "Web UI", "Каталог, корзина, подтверждение цены, статус заказа")
 Container(app, "Приложение магазина", "Прикладной backend", "Каталог, заказ, профиль и оплата; итог по ценам ERP и скидкам Loyalty, согласие покупателя")
 Container(worker, "Обработка обменов", "Фоновый worker", "Outbox, inbox, проекции событий и актуализация статуса заказа")
 ContainerDb(db, "Данные интернет-магазина", "Собственное хранилище", "Заказ, снимки цен ERP, персональных скидок и итоговой суммы; связи ID и проекции каталога/Stock")
}
System_Ext(ip, "IS-07 — общая платформа", "API, события, адаптеры, устойчивый ход обменов заказа")
System_Ext(erp, "ERP", "Товары и цены; учётный заказ хранит применённые скидки и итог; только ERP выпускает задание WMS")
System_Ext(wms, "WMS", "Резерв до оплаты, confirm-paid*, подбор и передача")
System_Ext(ret, "CRM / Loyalty / Recommendations", "customerId, персональная скидка, отдельные бонусные операции, готовые списки товаров")
System_Ext(providers, "Оплата / доставка / коммуникации", "Провайдеры за адаптерами платформы")
Rel(buyer, web, "Пользуется", "HTTPS")
Rel(operator, web, "Сопровождает", "HTTPS + роль")
Rel(web, app, "Действия пользователя", "API магазина")
Rel(app, db, "Заказ/снимки/намерение отправки", "Локальная транзакция")
Rel(worker, db, "Outbox/inbox и проекции", "Локальная транзакция")
BiRel(app, ip, "Цены ERP, скидка Loyalty, профиль, резерв, оплата", "INT API-01–10/17–19/24/28")
BiRel(worker, ip, "Поручения и подтверждённые факты", "Команды / события")
BiRel(ip, erp, "API-03: цены; API-10: заказ с применёнными скидками", "API / события")
BiRel(ip, wms, "Общий маршрут", "API / события")
BiRel(ip, ret, "API-28: персональная скидка; бонусы отдельно API-17/18", "API / события")
BiRel(ip, providers, "Проверенные callback и команды", "API / адаптеры")
SHOW_LEGEND()
footer * confirm-paid — предлагаемое расширение. Модули backend не предписаны отдельными микросервисами; интерактивная платёжная страница провайдера опущена.
@enduml
