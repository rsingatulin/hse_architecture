@startuml INT-C4-002-platform
!pragma layout smetana
!$LEGEND_TITLE_TEXT = "Условные обозначения"
!$PERSON_LEGEND_TEXT = "пользователь"
!$EXTERNAL_PERSON_LEGEND_TEXT = "внешний пользователь"
!$SYSTEM_LEGEND_TEXT = "система"
!$EXTERNAL_SYSTEM_LEGEND_TEXT = "внешняя система"
!$SYSTEM_BOUNDARY_TYPE = "система"
!$SYSTEM_BOUNDARY_LEGEND_TEXT = "граница системы"
!$CONTAINER_LEGEND_TEXT = "контейнер"
!$EXTERNAL_CONTAINER_LEGEND_TEXT = "внешний контейнер"
!$CONTAINER_BOUNDARY_TYPE = "контейнер"
!$CONTAINER_BOUNDARY_LEGEND_TEXT = "граница контейнера"
!$LEGEND_BOUNDARY_DASHED_INCL_COMA = "пунктир, "
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam backgroundColor white
title Целевая структура общей платформы\nINT-C4-002 · контейнеры C4 · проект 1.3
System_Ext(caller, "Системы бизнес-доменов", "Отправляют запросы и команды, получают события и результаты операций")
System_Boundary(ip, "IS-07 — общая интеграционная платформа") {
 Container(gw, "API-шлюз", "Управляемые API", "Проверка прав, маршрутизация и квоты; отдельные правила для внешних запросов")
 Container(flow, "Координатор обменов", "Восстановление после сбоев", "Шаги, сроки ожидания, operationId и проверка результатов; бизнес-правила задаёт система-владелец")
 Container(bus, "Доставка команд и событий", "Продукт не выбран", "Сохранение сообщений, повторная доставка, отдельные очереди и подписки")
 Container(adapt, "Адаптеры систем", "Поддерживаемые интерфейсы", "Обмен с ERP, WMS, CRM, магазинами и провайдерами; преобразование форматов и сверка результатов")
 ContainerDb(state, "Журнал обменов", "Постоянное хранилище", "IntegrationRun, commandId, связи идентификаторов, подтверждения и версии сценариев; бизнес-данные хранятся у владельцев")
 Container(catalog, "Каталог контрактов", "API и схемы", "Версии, владельцы, совместимость и права")
 Container(ops, "Контроль и восстановление", "DLQ / аудит / мониторинг", "Задержки доставки, зависшие шаги, сверка и повторная обработка по решению оператора")
}
System_Ext(owner, "Системы — исполнители операций", "ERP, WMS, CRM, сервисы бизнес-доменов и внешние провайдеры; собственные БД и журналы")
Rel(caller, gw, "Запрос / команда / статус", "HTTPS")
Rel(gw, adapt, "Ограниченное ожидание ответа", "Синхронный маршрут")
Rel(gw, flow, "Принять длительную операцию", "202 + operationId после сохранения")
Rel(flow, state, "Сохранить шаг до исполнения, прочитать результат", "Транзакция / защита от параллельного выполнения")
Rel(flow, bus, "Отправить команду следующего шага", "Сохранение и повторные попытки")
Rel(bus, adapt, "Команда одному исполнителю", "Сообщение")
BiRel(adapt, owner, "Запросы, команды, результаты и записи журнала", "API / CDC / периодический опрос")
Rel(adapt, bus, "Сообщить о выполненных операциях", "События")
Rel(bus, flow, "Результат шага", "Отдельная подписка")
Rel(bus, caller, "Доставить события всем получателям с правом доступа", "Подписки / журнал обработки")
Rel(caller, bus, "Отправить сохранённые события", "Очередь отправки / проверка схем и ACL")
Rel(catalog, gw, "Политики и версии", "Конфигурация")
Rel(catalog, bus, "Схемы и права", "Конфигурация")
Rel(bus, ops, "Сообщить об ошибках и задержках доставки", "DLQ / метрики")
Rel(state, ops, "Зависшие шаги и сверка", "Контролируемое чтение")
SHOW_LEGEND()
footer
Показаны логические компоненты. Источник сохраняет событие вместе с результатом операции (Outbox), получатель ведёт журнал обработки (Inbox).
Отдельная БД адаптера не обеспечивает общую транзакцию с ERP.
end footer
@enduml
