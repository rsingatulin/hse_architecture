@startuml INT-C4-002-platform
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam backgroundColor white
title Общая платформа — логические контейнеры To-Be\nINT-C4-002 · проект 1.0
System_Ext(caller, "Домены и каналы", "Инициаторы запросов/команд и потребители фактов")
System_Boundary(ip, "IS-07 — одна корпоративная Integration Platform") {
 Container(gw, "API Gateway", "Управляемые API", "Права сервисов, маршруты, квоты; отдельные политики внешнего входа")
 Container(flow, "Координатор обменов", "Устойчивое исполнение сценариев", "Шаги, deadline, operationId, проверка результатов; правила задаёт домен")
 Container(bus, "Транспорт команд и событий", "Продукт не выбран", "Устойчивые очереди, отдельные подписки, повторная доставка и изоляция")
 Container(adapt, "Адаптеры систем", "Поддерживаемые интерфейсы", "ERP/WMS/CRM, платежи, доставка, поставщики; перевод контрактов и сверка")
 ContainerDb(state, "Журнал обменов", "Устойчивое хранилище", "IntegrationRun, commandId, связи ID, подтверждения и версии сценария; не мастер бизнес-данных")
 Container(catalog, "Каталог контрактов", "API и схемы", "Версии, владельцы, совместимость и права")
 Container(ops, "Контроль и восстановление", "DLQ / аудит / мониторинг", "Lag, зависшие шаги, сверка и управляемый replay")
}
System_Ext(owner, "Системы — владельцы результата", "ERP, WMS, CRM, доменные сервисы и внешние провайдеры; свои БД и журналы")
Rel(caller, gw, "Запрос / команда / статус", "HTTPS")
Rel(gw, adapt, "Ограниченное ожидание ответа", "Синхронный маршрут")
Rel(gw, flow, "Принять длительную операцию", "202 + operationId после сохранения")
Rel(flow, state, "Сохраняет шаг до исполнения, читает результат", "Транзакция / fencing")
Rel(flow, bus, "Доставить согласованный шаг", "Устойчивая команда")
Rel(bus, adapt, "Команда одному исполнителю", "Сообщение")
BiRel(adapt, owner, "Команда/запрос; результат/журнал", "Поддерживаемый API / CDC / polling")
Rel(adapt, bus, "Подтверждённые факты и результаты", "События")
Rel(bus, flow, "Результат шага", "Отдельная подписка")
Rel(bus, caller, "Факты каждому разрешённому потребителю", "Отдельные подписки / inbox")
Rel(caller, bus, "Зафиксированные факты из outbox", "Проверенные схемы и ACL")
Rel(catalog, gw, "Политики и версии", "Конфигурация")
Rel(catalog, bus, "Схемы и права", "Конфигурация")
Rel(bus, ops, "Исчерпанные повторы / lag", "DLQ / метрики")
Rel(state, ops, "Зависшие шаги и сверка", "Контролируемое чтение")
SHOW_LEGEND()
footer Логическое разбиение, не отдельные кластеры. Outbox источника и inbox получателя обязательны; БД адаптера не даёт атомарности с ERP.
@enduml
