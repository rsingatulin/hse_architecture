@startuml INT-C4-001-landscape
!pragma layout smetana
!$LEGEND_TITLE_TEXT = "Условные обозначения"
!$PERSON_LEGEND_TEXT = "пользователь"
!$EXTERNAL_PERSON_LEGEND_TEXT = "внешний пользователь"
!$SYSTEM_LEGEND_TEXT = "система"
!$EXTERNAL_SYSTEM_LEGEND_TEXT = "внешняя система"
!$SYSTEM_BOUNDARY_TYPE = "система"
!$SYSTEM_BOUNDARY_LEGEND_TEXT = "граница системы"
!$CONTAINER_LEGEND_TEXT = "контейнер"
!$EXTERNAL_CONTAINER_LEGEND_TEXT = "внешний контейнер"
!$CONTAINER_BOUNDARY_TYPE = "контейнер"
!$CONTAINER_BOUNDARY_LEGEND_TEXT = "граница контейнера"
!$LEGEND_BOUNDARY_DASHED_INCL_COMA = "пунктир, "
!include <C4/C4_Context>
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName Arial
skinparam backgroundColor white
title RetailMax — целевая схема интеграции\nINT-C4-001 · взаимодействие систем · проект 1.3
System(pos, "1. Розничный магазин / POS", "Продажи и скидки CRM без интернета; локальный учёт товаров и очередь изменений для WMS")
System(shop, "4. Интернет-магазин", "Каталог, корзина, заказы покупателей, профиль, оплата и статусы")
System(ip, "IS-07 — интеграционная платформа", "Общие API, доставка команд с повторными попытками, обмен событиями и адаптеры систем")
System(erp, "2. Закупки / ERP", "Товары, цены, поставщики, закупки и учёт; читает остатки WMS по запросу")
System(wms, "3. Общая WMS — складской учёт", "Остатки центрального склада и магазинов; резервы, приёмки, перемещения и контроль обмена с магазинами")
System(ret, "5. Лояльность / CRM / аналитика", "Клиенты, скидки, бонусы и маркетинговые кампании; аналитическое хранилище и рекомендации")
System(shared, "Управление доступом / SSO", "Вход пользователей и роли; идентификация сервисов")
System_Ext(ext, "Внешние системы", "Платёжный провайдер, перевозчики, поставщики, почта, SMS и уведомления")
BiRel(pos, ip, "Изменения запасов и состояние связи: API-29/30; подтверждения WMS; продажи: EVT-16", "HTTPS / сообщения")
BiRel(shop, ip, "Цены, персональная скидка, резерв, оплата и заказ", "HTTPS / сообщения")
BiRel(ip, erp, "Чтение остатков WMS: API-04; уведомления об изменениях; планы пополнения: API-31", "API / сообщения")
BiRel(ip, wms, "Изменения запасов магазинов, подтверждения и пополнение: API-29–31 / EVT-25–27; складские операции", "API / сообщения")
BiRel(ip, ret, "Скидки: API-28/32, EVT-28; профиль, бонусы, рекомендации", "API / подписки")
BiRel(ip, shared, "Идентификация и роли", "Защищённые API")
BiRel(ip, ext, "Запросы, результаты операций и проверенные уведомления", "Адаптеры провайдеров")
SHOW_LEGEND()
footer
Магазин сообщает общей WMS об изменениях запасов через IS-07. WMS обновляет остатки и уведомляет закупки. При отсутствии сети магазин сохраняет
изменения и отправляет их после восстановления связи.
end footer
@enduml
