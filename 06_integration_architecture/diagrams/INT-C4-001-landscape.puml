@startuml INT-C4-001-landscape
!pragma layout smetana
!include <C4/C4_Context>
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName Arial
skinparam backgroundColor white
title RetailMax — общая интеграция To-Be\nINT-C4-001 · логический ландшафт · проект 1.3
System(pos, "1. Розничный магазин / POS", "Продажи и локальные скидки CRM без интернета; склад магазина, Inventory/Outbox логистики и журнал движений")
System(shop, "4. Интернет-магазин", "Каталог, корзина, заказ канала, профиль, оплата и статусы")
System(ip, "IS-07 Integration Platform", "Один общий слой: API, устойчивые команды, события, адаптеры и координация")
System(erp, "2. Закупки / ERP", "Товары, цены, поставщики, закупки и учёт; читает остатки WMS по запросу")
System(wms, "3. Warehouse / WMS", "Подтверждённые остатки CENTRAL и STORE, резерв, приёмка, перемещение и контроль синхронизации магазинов")
System(ret, "5. Retention / CRM / аналитика", "CRM: клиенты, скидки, бонусы и маркетинговые кампании; аналитическое хранилище и рекомендации")
System(shared, "Identity / SSO", "Вход пользователей и роли; идентификация сервисов")
System_Ext(ext, "Внешние системы", "Платёжный провайдер, перевозчики, поставщики, email/SMS/push")
BiRel(pos, ip, "Движения/heartbeat: API-29/30; подтверждения WMS; EVT-16", "HTTPS / журнал и сообщения")
BiRel(shop, ip, "Цены, персональная скидка, резерв, оплата и заказ", "HTTPS / сообщения")
BiRel(ip, erp, "Остатки по запросу: API-04; уведомления магазина; пополнение: API-31", "Поддерживаемые API / журнал")
BiRel(ip, wms, "Магазины: API-29–31 / EVT-25–27; складские API/факты", "Поддерживаемые API / журнал")
BiRel(ip, ret, "Скидки: API-28/32, EVT-28; профиль, бонусы, рекомендации", "API / подписки")
BiRel(ip, shared, "Идентификация и роли", "Защищённые API")
BiRel(ip, ext, "Команды, проверенные callback и результаты", "Адаптеры провайдеров")
SHOW_LEGEND()
footer Обязательный маршрут: магазин и его склад → IS-07 → WMS → IS-07 → закупки. Локальные модули POS работают без обращения в центр; журнал доставляется после восстановления сети.
@enduml
