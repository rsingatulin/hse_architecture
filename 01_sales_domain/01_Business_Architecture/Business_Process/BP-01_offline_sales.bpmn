    <bpmn:sequenceFlow id="Flow_5" name="Да" sourceRef="Gateway_1" targetRef="Task_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{loyaltyCard == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Нет" sourceRef="Gateway_1" targetRef="Gateway_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{loyaltyCard == false}</bpmn:conditionExpression>
