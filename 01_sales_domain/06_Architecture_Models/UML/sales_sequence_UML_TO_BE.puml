@startuml sales_sequence_UML_TO_BE

skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

title
RetailMax — Кассовое приложение
UML Sequence Diagram (TO-BE, ADR-001)
Взаимодействие компонентов при продаже по карте лояльности
end title

' ==========================================
' Участники (по C4 Container, UML Component и ADR-001)
' ==========================================

actor "Кассир" as Cashier

box "Кассовое приложение <<container>>" #F3F6FA
  participant "Cashier UI" as UI
  participant "Sale\nProcessing" as Sale
  participant "Discount & Loyalty\nHandling" as Loyalty
  participant "Local Cache\n(новый, ADR-001)" as Cache #E8F5E9
  participant "Integration\nAdapter" as Integration
  participant "Fiscal\nAdapter" as FiscalAdapter
  participant "POS Data\nAccess" as DataAccess
end box

participant "Фискальный\nмодуль" as Fiscal
database "БД POS" as POS_DB
participant "Integration Platform\n(IS-07)\nCRM, ERP" as IP

' ==========================================
' 0. Периодическая подгрузка данных
' ==========================================

== Фоновая синхронизация (каждые 5 минут и по событиям) ==

loop периодически, вне продажи
  Cache -> Integration : запросить изменения\nцен, акций и бонусов
  Integration -> IP : изменения с момента\nпоследней синхронизации
  IP --> Integration : новые цены, акции,\nуровни и балансы
  Integration --> Cache : изменения
  Cache -> DataAccess : обновить локальный кэш
  DataAccess -> POS_DB : UPSERT кэш
end

' ==========================================
' 1. Сканирование товаров
' ==========================================

== Сканирование товаров ==

Cashier -> UI : сканирует товары
UI -> Sale : начать продажу, добавить позиции
Sale -> Cache : цены и акции
Cache --> Sale : цены и акции из кэша
Sale --> UI : состав и сумма чека

' ==========================================
' 2. Карта лояльности
' ==========================================

== Применение скидок и бонусов ==

Cashier -> UI : сканирует карту лояльности
UI -> Sale : добавить карту в чек
Sale -> Loyalty : применить скидки и бонусы
Loyalty -> Integration : уточнить баланс в CRM\n(таймаут 2 секунды)
Integration -> IP : уровень и баланс (CRM)

alt CRM ответила за 2 секунды
  IP --> Integration : уровень, баланс, скидка
  Integration --> Loyalty : актуальные данные
  Loyalty -> Cache : обновить карту клиента
else CRM не ответила
  IP --> Integration : таймаут
  Integration --> Loyalty : таймаут
  Loyalty -> Cache : уровень и баланс клиента
  Cache --> Loyalty : данные из кэша,\nпометка «не подтверждено»
  note right of Loyalty
    Продажа не ждет CRM.
    Закрывает проблему INT-02
  end note
end

Loyalty -> Loyalty : рассчитать скидку\nи доступные бонусы
Loyalty --> Sale : скидка и бонусы
Sale --> UI : итог чека
UI --> Cashier : сумма к оплате

' ==========================================
' 3. Закрытие чека
' ==========================================

== Оплата и закрытие чека ==

Cashier -> UI : оплата получена, закрыть чек
UI -> Sale : завершить продажу
Sale -> FiscalAdapter : сформировать фискальный чек
FiscalAdapter -> Fiscal : печать и фискализация,\nAPI драйвера
Fiscal --> FiscalAdapter : чек напечатан
FiscalAdapter --> Sale : ok
Sale -> DataAccess : сохранить продажу и чек,\nпоставить в очередь отправки
DataAccess -> POS_DB : INSERT чек, операция,\nзапись в очередь
POS_DB --> DataAccess : ok
Sale --> UI : продажа завершена
UI --> Cashier : продажа завершена

' ==========================================
' 4. Передача продажи
' ==========================================

== Передача факта продажи (фоном) ==

loop пока есть неотправленные продажи
  Integration -> DataAccess : взять продажу из очереди
  DataAccess --> Integration : продажа (ключ = номер чека)
  Integration -> IP : продажа (ERP), продажа по карте (CRM)

  alt системы приняли
    IP --> Integration : ok, новый баланс бонусов
    Integration -> DataAccess : отметить отправленной
    Integration -> Cache : обновить баланс клиента
  else ошибка или нет связи
    IP --> Integration : ошибка
    note right of Integration
      Продажа остается в очереди
      и уйдет при следующей попытке.
      Повтор с тем же ключом не
      задваивает бонусы (INT-01)
    end note
  end
end

@enduml
