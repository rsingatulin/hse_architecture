@startuml sales_sequence_UML_TO_BE

skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 230
autonumber

title RetailMax — CRM\nUML Sequence Diagram (TO-BE)\nПрименение и начисление бонусов при оффлайн-продаже

' ==========================================
' Участники (по C4 Context и UML Component)
' ==========================================

actor "Покупатель" as Customer
actor "Старший продавец\nмагазина" as Seller
participant "POS\n(IS-04)" as POS
participant "Integration Platform\n(IS-07)" as IP

box "CRM (IS-02)" #F3F6FA
  participant "Customer\nManagement" as CM
  participant "Loyalty\nProgram" as LP
  participant "Purchase\nHistory" as PH
end box

participant "ERP\n(IS-01)" as ERP

' ==========================================
' 1. Сканирование товаров
' ==========================================

== Сканирование товаров ==

Customer -> Seller : передает товары и карту лояльности
Seller -> POS : сканирует товары
POS -> POS : применить цены и акции\nиз локального справочника ERP

' ==========================================
' 2. Проверка карты лояльности
' ==========================================

== Проверка карты лояльности ==

opt есть карта лояльности
  Seller -> POS : сканирует карту
  POS -> IP : запрос статуса карты\n(номер карты)
  IP -> CM : найти клиента по карте
  CM --> IP : клиент найден
  IP -> LP : запрос уровня, баланса\nи персональной скидки
  LP --> IP : уровень, баланс,\nскидка (версия N)

  alt ответ получен за 2 секунды
    IP --> POS : уровень, баланс, скидка
    POS -> POS : обновить локальный кэш клиента
  else CRM не ответила за 2 секунды
    IP --> POS : таймаут
    POS -> POS : взять уровень из кэша,\nпометить «не подтверждено»
    note right of POS
      Продажа не ждет CRM.
      Закрывает проблему AS-IS INT-02
      (задержки увеличивают время
      обслуживания на кассе)
    end note
  end

  POS --> Seller : скидка и доступные бонусы
  Seller -> Customer : предлагает списать бонусы
  Customer --> Seller : согласие или отказ
end

' ==========================================
' 3. Оплата и отправка факта продажи
' ==========================================

== Оплата и фиксация продажи ==

Customer -> Seller : оплачивает покупку
Seller -> POS : закрыть чек
POS -> POS : оформить чек, поставить продажу\nв очередь отправки\n(ключ = номер чека)
POS --> Customer : чек

POS -> IP : факт продажи
IP ->> ERP : факт продажи (асинхронно)

' ==========================================
' 4. Списание и начисление бонусов
' ==========================================

== Списание и начисление бонусов ==

opt продажа по карте лояльности
  loop пока CRM не подтвердит продажу
    POS -> IP : продажа по карте\n(чек, сумма, списание бонусов, ключ)
    IP -> LP : применить продажу
    LP -> LP : проверить ключ чека

    alt чек уже обработан
      LP --> IP : повтор, бонусы не меняются
    else новый чек
      LP -> LP : списать и начислить бонусы,\nпересчитать уровень (версия N+1)
      LP -> PH : записать покупку в историю
      PH --> LP : ok
      LP --> IP : новый баланс и уровень
    end

    IP --> POS : подтверждение списания и начисления
    POS -> POS : убрать продажу из очереди,\nобновить кэш клиента
  end
  note right of POS
    При сбое связи POS повторяет отправку
    с тем же ключом. Бонусы не теряются
    и не начисляются дважды
  end note
end

@enduml
