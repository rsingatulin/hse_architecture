@startuml POS_APP_COMPONENTS_AS_IS

left to right direction

skinparam componentStyle uml2
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

title
RetailMax — Кассовое приложение
UML Component Diagram (AS-IS)
Внутренняя структура контейнера POS Application
end title


' =========================================================
' ВНЕШНИЙ ПОЛЬЗОВАТЕЛЬ
' =========================================================

actor "Кассир" as Cashier


' =========================================================
' ВЫБРАННЫЙ КОНТЕЙНЕР
' =========================================================

package "Кассовое приложение\n<<container>>" {

    component "Cashier UI\n<<component>>" as UI

    component "Sale Processing\n<<component>>" as Sale

    component "Discount & Loyalty\nHandling\n<<component>>" as Loyalty

    component "Integration Adapter\n<<component>>" as Integration

    component "Fiscal Adapter\n<<component>>" as FiscalAdapter

    component "POS Data Access\n<<component>>" as DataAccess
}


' =========================================================
' ВНЕШНИЕ КОНТЕЙНЕРЫ / СИСТЕМЫ
' =========================================================

component "Фискальный модуль\n<<container>>" as Fiscal

database "БД POS\n<<container>>" as POS_DB

component "Integration Platform\n(IS-07)\n<<external system>>" as IP


' =========================================================
' ВНУТРЕННИЕ ЗАВИСИМОСТИ
' =========================================================

Cashier --> UI : действия кассира

UI --> Sale : начать / изменить /\nзавершить продажу

Sale --> Loyalty : применить скидки\nи бонусы

Sale --> FiscalAdapter : сформировать\nфискальный чек

Sale --> DataAccess : сохранить\nпродажу и чек

Sale --> Integration : запросить данные /\nпередать факт продажи

Loyalty --> Integration : получить данные\nпрограммы лояльности


' =========================================================
' ВНЕШНИЕ ВЗАИМОДЕЙСТВИЯ
' =========================================================

Integration --> IP : REST API

FiscalAdapter --> Fiscal : API драйвера

DataAccess --> POS_DB : SQL


' =========================================================
' ПОЯСНЕНИЯ
' =========================================================

note bottom of Sale

Основная ответственность:
координация процесса продажи,
формирование состава и итогов чека,
завершение операции.

end note


note bottom of Loyalty

AS-IS:

для применения бонусов
и персональных скидок
компонент использует данные,
получаемые через Integration Adapter.

При задержке внешнего ответа
оформление продажи задерживается.

end note


note bottom of Integration

Единая точка взаимодействия
компонентов кассового приложения
с Integration Platform.

Через неё выполняются запросы
к корпоративным системам.

end note


note bottom of FiscalAdapter

Изолирует Sale Processing
от конкретного интерфейса
фискального модуля.

end note


note bottom of DataAccess

Отвечает за доступ
кассового приложения
к БД POS.

end note

@enduml
