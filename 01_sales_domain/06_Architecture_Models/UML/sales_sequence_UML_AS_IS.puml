@startuml sales_sequence_UML_AS_IS

skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

title
RetailMax — Кассовое приложение
UML Sequence Diagram (AS-IS)
Взаимодействие компонентов при продаже по карте лояльности
end title

' ==========================================
' Участники (по C4 Container и UML Component)
' ==========================================

actor "Кассир" as Cashier

box "Кассовое приложение <<container>>" #F3F6FA
  participant "Cashier UI" as UI
  participant "Sale\nProcessing" as Sale
  participant "Discount & Loyalty\nHandling" as Loyalty
  participant "Integration\nAdapter" as Integration
  participant "Fiscal\nAdapter" as FiscalAdapter
  participant "POS Data\nAccess" as DataAccess
end box

participant "Фискальный\nмодуль" as Fiscal
database "БД POS" as POS_DB
participant "Integration Platform\n(IS-07)\nCRM, ERP" as IP

' ==========================================
' 1. Сканирование товаров
' ==========================================

== Сканирование товаров ==

Cashier -> UI : сканирует товары
UI -> Sale : начать продажу, добавить позиции
Sale -> Integration : запросить цены и акции
Integration -> IP : цены и акции (ERP), REST синхронно
IP --> Integration : цены и акции
Integration --> Sale : цены и акции
Sale --> UI : состав и сумма чека

' ==========================================
' 2. Карта лояльности
' ==========================================

== Применение скидок и бонусов ==

Cashier -> UI : сканирует карту лояльности
UI -> Sale : добавить карту в чек
Sale -> Loyalty : применить скидки и бонусы
activate Loyalty
Loyalty -> Integration : получить данные программы лояльности
activate Integration
Integration -> IP : уровень, баланс, скидка (CRM),\nREST синхронно

alt CRM ответила
  IP --> Integration : уровень, баланс, скидка
  Integration --> Loyalty : данные лояльности
  Loyalty -> Loyalty : рассчитать скидку\nи доступные бонусы
  Loyalty --> Sale : скидка и бонусы
else CRM отвечает медленно или недоступна
  note over Integration, IP
    Таймаута нет, локального
    кэша данных лояльности нет
  end note
  IP --> Integration : ошибка после ожидания
  Integration --> Loyalty : ошибка
  Loyalty --> Sale : скидки и бонусы не применены
  note right of Sale
    Проблема AS-IS (INT-02).
    Продажа стоит, пока ждут CRM,
    затем покупка проходит без бонусов
  end note
end
deactivate Integration
deactivate Loyalty

Sale --> UI : итог чека
UI --> Cashier : сумма к оплате

' ==========================================
' 3. Закрытие чека
' ==========================================

== Оплата и закрытие чека ==

Cashier -> UI : оплата получена, закрыть чек
UI -> Sale : завершить продажу
Sale -> FiscalAdapter : сформировать фискальный чек
FiscalAdapter -> Fiscal : печать и фискализация,\nAPI драйвера
Fiscal --> FiscalAdapter : чек напечатан
FiscalAdapter --> Sale : ok
Sale -> DataAccess : сохранить продажу и чек
DataAccess -> POS_DB : INSERT чек, операция
POS_DB --> DataAccess : ok

' ==========================================
' 4. Передача продажи
' ==========================================

== Передача факта продажи ==

Sale -> Integration : передать факт продажи
Integration -> IP : продажа (ERP), продажа по карте (CRM),\nREST без повторной отправки

alt системы приняли
  IP --> Integration : ok
else ошибка или высокая нагрузка
  IP --> Integration : ошибка
  note right of Integration
    Проблема AS-IS (INT-01).
    Повтора нет, продажа и бонусы
    теряются, баланс в CRM
    расходится с покупками
  end note
end

Integration --> Sale : результат
Sale --> UI : продажа завершена
UI --> Cashier : продажа завершена

@enduml
