<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BP01_ASIS" targetNamespace="https://retailmax.example/bpmn/sales">
  <bpmn:message id="Message_ConsultRequest" name="Запрос консультации" />
  <bpmn:message id="Message_ConsultResult" name="Результат консультации" />
  <bpmn:message id="Message_Basket" name="Выбранные товары" />
  <bpmn:message id="Message_Amount" name="Сумма к оплате" />
  <bpmn:message id="Message_Payment" name="Подтверждение оплаты" />
  <bpmn:message id="Message_Receipt" name="Товар и чек" />
  <bpmn:message id="Message_LoyaltyRequest" name="Запрос бонусов и скидок" />
  <bpmn:message id="Message_LoyaltyResponse" name="Ответ CRM: бонусы и скидки" />
  <bpmn:message id="Message_SaleFact" name="Факт продажи" />
  <bpmn:collaboration id="Collaboration_BP01_ASIS">
    <bpmn:participant id="Participant_Buyer" name="Покупатель" processRef="Process_Buyer" />
    <bpmn:participant id="Participant_Seller" name="Продавец-консультант" processRef="Process_Seller" />
    <bpmn:participant id="Participant_POS" name="Кассир и POS" processRef="Process_POS" />
    <bpmn:participant id="Participant_IP" name="Integration Platform (IS-07)" processRef="Process_IP" />
    <bpmn:participant id="Participant_CRM" name="CRM" processRef="Process_CRM" />
    <bpmn:participant id="Participant_ERP" name="ERP" processRef="Process_ERP" />
    <bpmn:messageFlow id="MF_ConsultRequest" name="Запрос консультации" sourceRef="Buyer_AskConsult" targetRef="Seller_Start" messageRef="Message_ConsultRequest" />
    <bpmn:messageFlow id="MF_ConsultResult" name="Результат консультации" sourceRef="Seller_SendAdvice" targetRef="Buyer_ReceiveConsult" messageRef="Message_ConsultResult" />
    <bpmn:messageFlow id="MF_Basket" name="Выбранные товары" sourceRef="Buyer_SendBasket" targetRef="POS_Start" messageRef="Message_Basket" />
    <bpmn:messageFlow id="MF_Amount" name="Сумма к оплате" sourceRef="POS_SendAmount" targetRef="Buyer_ReceiveAmount" messageRef="Message_Amount" />
    <bpmn:messageFlow id="MF_Payment" name="Подтверждение оплаты" sourceRef="Buyer_SendPayment" targetRef="POS_ReceivePayment" messageRef="Message_Payment" />
    <bpmn:messageFlow id="MF_Receipt" name="Товар и чек" sourceRef="POS_Handover" targetRef="Buyer_ReceiveReceipt" messageRef="Message_Receipt" />
    <bpmn:messageFlow id="MF_POS_IP_Request" name="Запрос через IS-07" sourceRef="POS_RequestCRM" targetRef="IP_LoyaltyStart" messageRef="Message_LoyaltyRequest" />
    <bpmn:messageFlow id="MF_IP_CRM_Request" name="Запрос CRM через IS-07" sourceRef="IP_ToCRM" targetRef="CRM_LoyaltyStart" messageRef="Message_LoyaltyRequest" />
    <bpmn:messageFlow id="MF_CRM_IP_Response" name="Ответ CRM" sourceRef="CRM_SendLoyalty" targetRef="IP_WaitCRM" messageRef="Message_LoyaltyResponse" />
    <bpmn:messageFlow id="MF_IP_POS_Response" name="Ответ через IS-07" sourceRef="IP_ToPOS" targetRef="POS_WaitCRM" messageRef="Message_LoyaltyResponse" />
    <bpmn:messageFlow id="MF_POS_IP_Sale" name="Факт продажи через IS-07" sourceRef="POS_FiscalSale" targetRef="IP_SaleStart" messageRef="Message_SaleFact" />
    <bpmn:messageFlow id="MF_IP_CRM_Sale" name="История покупки" sourceRef="IP_RouteSale" targetRef="CRM_SaleStart" messageRef="Message_SaleFact" />
    <bpmn:messageFlow id="MF_IP_ERP_Sale" name="Учёт продажи" sourceRef="IP_RouteSale" targetRef="ERP_SaleStart" messageRef="Message_SaleFact" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Buyer" name="Покупатель" isExecutable="false">
    <bpmn:startEvent id="Buyer_Start" name="Покупатель входит в магазин">
      <bpmn:outgoing>B_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Buyer_Select" name="Выбрать товар в торговом зале">
      <bpmn:incoming>B_F1</bpmn:incoming>
      <bpmn:outgoing>B_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Buyer_ConsultGate" name="Нужна консультация?" gatewayDirection="Diverging">
      <bpmn:incoming>B_F2</bpmn:incoming>
      <bpmn:outgoing>B_F3</bpmn:outgoing>
      <bpmn:outgoing>B_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Buyer_ConsultMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>B_F4</bpmn:incoming>
      <bpmn:incoming>B_F6</bpmn:incoming>
      <bpmn:outgoing>B_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Buyer_SendBasket" name="Передать товары кассиру" messageRef="Message_Basket">
      <bpmn:incoming>B_F7</bpmn:incoming>
      <bpmn:outgoing>B_F8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Buyer_ReceiveAmount" name="Получить сумму к оплате" messageRef="Message_Amount">
      <bpmn:incoming>B_F8</bpmn:incoming>
      <bpmn:outgoing>B_F9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Buyer_Pay" name="Выбрать способ и оплатить покупку">
      <bpmn:incoming>B_F9</bpmn:incoming>
      <bpmn:outgoing>B_F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Buyer_SendPayment" name="Подтвердить оплату кассиру" messageRef="Message_Payment">
      <bpmn:incoming>B_F10</bpmn:incoming>
      <bpmn:outgoing>B_F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Buyer_ReceiveReceipt" name="Получить товар и чек" messageRef="Message_Receipt">
      <bpmn:incoming>B_F11</bpmn:incoming>
      <bpmn:outgoing>B_F12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Buyer_End" name="Покупка завершена">
      <bpmn:incoming>B_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B_F1" sourceRef="Buyer_Start" targetRef="Buyer_Select" />
    <bpmn:sequenceFlow id="B_F2" sourceRef="Buyer_Select" targetRef="Buyer_ConsultGate" />
    <bpmn:sequenceFlow id="B_F3" name="Да" sourceRef="Buyer_ConsultGate" targetRef="Buyer_AskConsult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationNeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B_F4" name="Нет" sourceRef="Buyer_ConsultGate" targetRef="Buyer_ConsultMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationNeeded == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="B_F5" sourceRef="Buyer_AskConsult" targetRef="Buyer_ReceiveConsult" />
    <bpmn:sequenceFlow id="B_F6" sourceRef="Buyer_ReceiveConsult" targetRef="Buyer_ConsultMerge" />
    <bpmn:sequenceFlow id="B_F7" sourceRef="Buyer_ConsultMerge" targetRef="Buyer_SendBasket" />
    <bpmn:sequenceFlow id="B_F8" sourceRef="Buyer_SendBasket" targetRef="Buyer_ReceiveAmount" />
    <bpmn:sequenceFlow id="B_F9" sourceRef="Buyer_ReceiveAmount" targetRef="Buyer_Pay" />
    <bpmn:sequenceFlow id="B_F10" sourceRef="Buyer_Pay" targetRef="Buyer_SendPayment" />
    <bpmn:sequenceFlow id="B_F11" sourceRef="Buyer_SendPayment" targetRef="Buyer_ReceiveReceipt" />
    <bpmn:sequenceFlow id="B_F12" sourceRef="Buyer_ReceiveReceipt" targetRef="Buyer_End" />
    <bpmn:receiveTask id="Buyer_ReceiveConsult" name="Получить консультацию" messageRef="Message_ConsultResult">
      <bpmn:incoming>B_F5</bpmn:incoming>
      <bpmn:outgoing>B_F6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Buyer_AskConsult" name="Запросить консультацию" messageRef="Message_ConsultRequest">
      <bpmn:incoming>B_F3</bpmn:incoming>
      <bpmn:outgoing>B_F5</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmn:process id="Process_Seller" name="Продавец-консультант" isExecutable="false">
    <bpmn:startEvent id="Seller_Start" name="Запрос консультации поступил">
      <bpmn:outgoing>S_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Seller_Start_MessageDef" messageRef="Message_ConsultRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="Seller_Consult" name="Проконсультировать покупателя">
      <bpmn:incoming>S_F1</bpmn:incoming>
      <bpmn:outgoing>S_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Seller_SendAdvice" name="Передать рекомендацию покупателю" messageRef="Message_ConsultResult">
      <bpmn:incoming>S_F2</bpmn:incoming>
      <bpmn:outgoing>S_F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Seller_End" name="Консультация завершена">
      <bpmn:incoming>S_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="S_F1" sourceRef="Seller_Start" targetRef="Seller_Consult" />
    <bpmn:sequenceFlow id="S_F2" sourceRef="Seller_Consult" targetRef="Seller_SendAdvice" />
    <bpmn:sequenceFlow id="S_F3" sourceRef="Seller_SendAdvice" targetRef="Seller_End" />
  </bpmn:process>
  <bpmn:process id="Process_POS" name="Кассир и POS" isExecutable="false">
    <bpmn:startEvent id="POS_Start" name="Товары переданы кассиру">
      <bpmn:outgoing>P_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="POS_Start_MessageDef" messageRef="Message_Basket" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="POS_Scan" name="Сканировать товары и проверить акции">
      <bpmn:incoming>P_F1</bpmn:incoming>
      <bpmn:outgoing>P_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="POS_RequestCRM" name="Запросить бонусы и скидки через IS-07" messageRef="Message_LoyaltyRequest">
      <bpmn:incoming>P_F3</bpmn:incoming>
      <bpmn:outgoing>P_F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="POS_ResponseGate" name="Ожидать ответ CRM или тайм-аут" gatewayDirection="Diverging">
      <bpmn:incoming>P_F5</bpmn:incoming>
      <bpmn:outgoing>P_F6</bpmn:outgoing>
      <bpmn:outgoing>P_F7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="POS_WaitCRM" name="Ожидать ответ CRM через IS-07" messageRef="Message_LoyaltyResponse">
      <bpmn:incoming>P_F6</bpmn:incoming>
      <bpmn:outgoing>P_F8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="POS_NoBenefits" name="Продолжить без бонусов и скидок">
      <bpmn:incoming>P_F9</bpmn:incoming>
      <bpmn:outgoing>P_F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="POS_LoyaltyMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>P_F4</bpmn:incoming>
      <bpmn:incoming>P_F8</bpmn:incoming>
      <bpmn:incoming>P_F10</bpmn:incoming>
      <bpmn:outgoing>P_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="POS_SendAmount" name="Сообщить покупателю итоговую сумму" messageRef="Message_Amount">
      <bpmn:incoming>P_F11</bpmn:incoming>
      <bpmn:outgoing>P_F12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="POS_ReceivePayment" name="Принять оплату покупателя" messageRef="Message_Payment">
      <bpmn:incoming>P_F12</bpmn:incoming>
      <bpmn:outgoing>P_F13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="POS_FiscalSale" name="Оформить чек и передать факт продажи в ERP/CRM через IS-07">
      <bpmn:incoming>P_F13</bpmn:incoming>
      <bpmn:outgoing>P_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="POS_Handover" name="Выдать товар и чек покупателю">
      <bpmn:incoming>P_F14</bpmn:incoming>
      <bpmn:outgoing>P_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="POS_End" name="Продажа завершена">
      <bpmn:incoming>P_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P_F1" sourceRef="POS_Start" targetRef="POS_Scan" />
    <bpmn:sequenceFlow id="P_F2" sourceRef="POS_Scan" targetRef="POS_LoyaltyGate" />
    <bpmn:sequenceFlow id="P_F3" name="Да" sourceRef="POS_LoyaltyGate" targetRef="POS_RequestCRM">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loyaltyCard == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P_F4" name="Нет" sourceRef="POS_LoyaltyGate" targetRef="POS_LoyaltyMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loyaltyCard == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P_F5" sourceRef="POS_RequestCRM" targetRef="POS_ResponseGate" />
    <bpmn:sequenceFlow id="P_F6" sourceRef="POS_ResponseGate" targetRef="POS_WaitCRM" />
    <bpmn:sequenceFlow id="P_F7" sourceRef="POS_ResponseGate" targetRef="POS_Timeout" />
    <bpmn:sequenceFlow id="P_F8" sourceRef="POS_WaitCRM" targetRef="POS_LoyaltyMerge" />
    <bpmn:sequenceFlow id="P_F9" sourceRef="POS_Timeout" targetRef="POS_NoBenefits" />
    <bpmn:sequenceFlow id="P_F10" sourceRef="POS_NoBenefits" targetRef="POS_LoyaltyMerge" />
    <bpmn:sequenceFlow id="P_F11" sourceRef="POS_LoyaltyMerge" targetRef="POS_SendAmount" />
    <bpmn:sequenceFlow id="P_F12" sourceRef="POS_SendAmount" targetRef="POS_ReceivePayment" />
    <bpmn:sequenceFlow id="P_F13" sourceRef="POS_ReceivePayment" targetRef="POS_FiscalSale" />
    <bpmn:sequenceFlow id="P_F14" sourceRef="POS_FiscalSale" targetRef="POS_Handover" />
    <bpmn:sequenceFlow id="P_F15" sourceRef="POS_Handover" targetRef="POS_End" />
    <bpmn:intermediateCatchEvent id="POS_Timeout" name="Тайм-аут ожидания CRM">
      <bpmn:incoming>P_F7</bpmn:incoming>
      <bpmn:outgoing>P_F9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="POS_Timeout_Timer">
        <bpmn:timeDuration>PT2S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="POS_LoyaltyGate" name="Есть карта лояльности?" gatewayDirection="Diverging">
      <bpmn:incoming>P_F2</bpmn:incoming>
      <bpmn:outgoing>P_F3</bpmn:outgoing>
      <bpmn:outgoing>P_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:process id="Process_IP" name="Integration Platform (IS-07)" isExecutable="false">
    <bpmn:startEvent id="IP_LoyaltyStart" name="Запрос лояльности от POS">
      <bpmn:outgoing>I_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IP_LoyaltyStart_MessageDef" messageRef="Message_LoyaltyRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="IP_ToCRM" name="Маршрутизировать запрос в CRM">
      <bpmn:incoming>I_F1</bpmn:incoming>
      <bpmn:outgoing>I_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="IP_WaitCRM" name="Ожидать ответ CRM" messageRef="Message_LoyaltyResponse">
      <bpmn:incoming>I_F2</bpmn:incoming>
      <bpmn:outgoing>I_F3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="IP_ToPOS" name="Вернуть ответ в POS" messageRef="Message_LoyaltyResponse">
      <bpmn:incoming>I_F3</bpmn:incoming>
      <bpmn:outgoing>I_F4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="IP_LoyaltyEnd" name="Ответ доставлен в POS">
      <bpmn:incoming>I_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="I_F1" sourceRef="IP_LoyaltyStart" targetRef="IP_ToCRM" />
    <bpmn:sequenceFlow id="I_F2" sourceRef="IP_ToCRM" targetRef="IP_WaitCRM" />
    <bpmn:sequenceFlow id="I_F3" sourceRef="IP_WaitCRM" targetRef="IP_ToPOS" />
    <bpmn:sequenceFlow id="I_F4" sourceRef="IP_ToPOS" targetRef="IP_LoyaltyEnd" />
    <bpmn:startEvent id="IP_SaleStart" name="Факт продажи получен от POS">
      <bpmn:outgoing>I_F5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IP_SaleStart_MessageDef" messageRef="Message_SaleFact" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="IP_RouteSale" name="Передать факт продажи адресатам: ERP и CRM">
      <bpmn:incoming>I_F5</bpmn:incoming>
      <bpmn:outgoing>I_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="IP_SaleEnd" name="Передача завершена">
      <bpmn:incoming>I_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="I_F5" sourceRef="IP_SaleStart" targetRef="IP_RouteSale" />
    <bpmn:sequenceFlow id="I_F6" sourceRef="IP_RouteSale" targetRef="IP_SaleEnd" />
  </bpmn:process>
  <bpmn:process id="Process_CRM" name="CRM" isExecutable="false">
    <bpmn:startEvent id="CRM_LoyaltyStart" name="Запрос лояльности получен">
      <bpmn:outgoing>C_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CRM_LoyaltyStart_MessageDef" messageRef="Message_LoyaltyRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CRM_Lookup" name="Найти клиента, бонусы и скидки">
      <bpmn:incoming>C_F1</bpmn:incoming>
      <bpmn:outgoing>C_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="CRM_SendLoyalty" name="Вернуть данные лояльности через IS-07" messageRef="Message_LoyaltyResponse">
      <bpmn:incoming>C_F2</bpmn:incoming>
      <bpmn:outgoing>C_F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="CRM_LoyaltyEnd" name="Ответ отправлен">
      <bpmn:incoming>C_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C_F1" sourceRef="CRM_LoyaltyStart" targetRef="CRM_Lookup" />
    <bpmn:sequenceFlow id="C_F2" sourceRef="CRM_Lookup" targetRef="CRM_SendLoyalty" />
    <bpmn:sequenceFlow id="C_F3" sourceRef="CRM_SendLoyalty" targetRef="CRM_LoyaltyEnd" />
    <bpmn:startEvent id="CRM_SaleStart" name="Факт продажи получен через IS-07">
      <bpmn:outgoing>C_F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CRM_SaleStart_MessageDef" messageRef="Message_SaleFact" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CRM_UpdateHistory" name="Обновить историю покупок клиента">
      <bpmn:incoming>C_F4</bpmn:incoming>
      <bpmn:outgoing>C_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CRM_SaleEnd" name="История обновлена">
      <bpmn:incoming>C_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C_F4" sourceRef="CRM_SaleStart" targetRef="CRM_UpdateHistory" />
    <bpmn:sequenceFlow id="C_F5" sourceRef="CRM_UpdateHistory" targetRef="CRM_SaleEnd" />
  </bpmn:process>
  <bpmn:process id="Process_ERP" name="ERP" isExecutable="false">
    <bpmn:startEvent id="ERP_SaleStart" name="Факт продажи получен через IS-07">
      <bpmn:outgoing>E_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ERP_SaleStart_MessageDef" messageRef="Message_SaleFact" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ERP_PostSale" name="Учесть продажу и обновить остатки">
      <bpmn:incoming>E_F1</bpmn:incoming>
      <bpmn:outgoing>E_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ERP_End" name="Продажа учтена">
      <bpmn:incoming>E_F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E_F1" sourceRef="ERP_SaleStart" targetRef="ERP_PostSale" />
    <bpmn:sequenceFlow id="E_F2" sourceRef="ERP_PostSale" targetRef="ERP_End" />
  </bpmn:process>
