@startuml C4_Containers

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

skinparam defaultFontName DejaVu Sans

AddElementTag("key", $bgColor="#4CAF50", $fontColor="#FFFFFF", $borderColor="#2E7D32", $legendText="ключевой контейнер (раскрыт в UML Component)")

title
RetailMax — POS (IS-04)
C4 Container Diagram (AS-IS)
Из каких контейнеров состоит кассовая система магазина
end title


' =========================================================
' ВНЕШНИЕ УЧАСТНИКИ
' =========================================================

Person(cashier, "Кассир", "Сканирует товары и карту лояльности, принимает оплату, закрывает чек")
Person(admin, "Администратор магазина", "Открывает и закрывает смены, управляет кассами, оформляет возвраты")


' =========================================================
' POS — ЦЕЛЕВАЯ СИСТЕМА
' =========================================================

System_Boundary(pos, "POS (IS-04)") {

    Container(pos_app, "Кассовое приложение", "Desktop-приложение на кассовом узле", "Оформление продажи, применение скидок и бонусов, формирование чека", $tags="key")
    Container(fiscal, "Фискальный модуль", "Драйвер ККТ", "Печать и фискализация чека")
    Container(backoffice, "Бэк-офис магазина", "Web-приложение", "Управление сменами и кассирами, возвраты, просмотр продаж магазина")
    ContainerDb(pos_db, "БД POS", "Реляционная СУБД", "Чеки, кассовые смены, журнал операций. Кэша цен и данных лояльности нет")
}


' =========================================================
' ВНЕШНЯЯ СИСТЕМА
' =========================================================

System_Ext(ip, "Integration Platform (IS-07)", "Передаёт запросы POS в ERP и CRM")


' =========================================================
' СВЯЗИ
' =========================================================

Rel(cashier, pos_app, "Сканирует товары и карту, закрывает чек")
Rel(admin, backoffice, "Управляет сменами и операциями магазина")

Rel(pos_app, fiscal, "Печать и фискализация чека", "API драйвера")
Rel(pos_app, pos_db, "Сохраняет чеки и операции", "SQL")
Rel(backoffice, pos_db, "Читает продажи, ведёт смены и возвраты", "SQL")

Rel(pos_app, ip, "Запрос цены и акций (ERP), бонусов и скидок по карте (CRM)", "REST, синхронно")
Rel(pos_app, ip, "Факт продажи (ERP), продажа по карте лояльности (CRM)", "REST, без повторной отправки")

note right of pos_app
Ключевой контейнер.
На UML Component раскрыт
на компоненты Sale Processing
и Discount & Loyalty Handling.
end note

note bottom of ip
Проблема AS-IS (INT-01, INT-02):
все обмены синхронные,
при задержке CRM продажа
ждёт ответа, при сбое
данные теряются.
end note

SHOW_LEGEND()

@enduml