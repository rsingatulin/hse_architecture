@startuml C4_Containers

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title
RetailMax — CRM
C4 Container Diagram (TO-BE)
Оффлайн-продажа и программа лояльности
end title


' =========================================================
' ВНЕШНИЕ УЧАСТНИКИ
' =========================================================

Person(customer, "Покупатель", "Совершает оффлайн-покупку")
Person(cashier, "Старший продавец магазина", "Обслуживает покупателя на кассовом узле")


' =========================================================
' ВНЕШНИЕ СИСТЕМЫ
' =========================================================

System(pos, "POS-система", "Кассовое ПО и АРМ продавца")
System(ip, "Интеграционная платформа (ESB/IP)", "Маршрутизация и трансформация сообщений")
System(erp, "ERP-система", "Справочники товаров и цен, приём факта продажи")


' =========================================================
' CRM — ЦЕЛЕВАЯ СИСТЕМА
' =========================================================

Container_Boundary(crm_boundary, "CRM (IS-02)") {

    Container(crm_api, "CRM API", "REST API", "Единая точка взаимодействия CRM с внешними системами")
    Container(customer_service, "Customer Service", "Application service", "Поиск клиента по номеру карты и получение данных клиента")
    Container(loyalty_service, "Loyalty Service", "Application service", "Получение уровня и баланса лояльности, применение скидок, списание и начисление бонусов")
    Container(history_service, "Purchase History", "Application service", "Фиксация покупок клиента и история операций")
    ContainerDb(crm_db, "CRM Database", "Database", "Данные клиентов, программы лояльности, балансы и история покупок")
}


' =========================================================
' ВНЕШНИЕ ВЗАИМОДЕЙСТВИЯ
' =========================================================

Rel(customer, cashier, "Передаёт товары и карту лояльности")
Rel(cashier, pos, "Сканирует товары и карту, инициирует продажу")

Rel(pos, ip, "Запрос данных клиента, бонусов и скидок", "REST API")
Rel(ip, pos, "Уровень, баланс, скидка", "REST API")

Rel(ip, crm_api, "Запрос данных клиента и данных лояльности", "REST API")
Rel(crm_api, ip, "Данные клиента, уровень, баланс, скидка", "REST API")


' =========================================================
' ВНУТРИ CRM
' =========================================================

Rel(crm_api, customer_service, "Запрос клиента")
Rel(customer_service, crm_db, "Чтение данных клиента")

Rel(crm_api, loyalty_service, "Запрос уровня, баланса и скидки")
Rel(loyalty_service, crm_db, "Чтение и изменение данных лояльности")

Rel(loyalty_service, history_service, "Фиксация покупки")
Rel(history_service, crm_db, "Запись истории покупки")


' =========================================================
' ERP
' =========================================================

Rel(ip, erp, "Получение справочников и отправка факта продажи", "API / асинхронно")


' =========================================================
' TO-BE РЕШЕНИЕ
' =========================================================

note right of crm_api
CRM взаимодействует с POS
через Integration Platform.

Внутренние функции CRM
разделены на отдельные
логические контейнеры.
end note


@enduml