@startuml C4_Containers_TO_BE

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

skinparam defaultFontName DejaVu Sans

AddElementTag("key", $bgColor="#4CAF50", $fontColor="#FFFFFF", $borderColor="#2E7D32", $legendText="ключевой контейнер (раскрыт в UML Component)")
AddElementTag("new", $bgColor="#1E88E5", $fontColor="#FFFFFF", $borderColor="#0D47A1", $legendText="новый контейнер TO-BE")
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#0D47A1", $textColor="#0D47A1", $legendText="асинхронный обмен / периодическая синхронизация")

title
RetailMax — POS (IS-04)
C4 Container Diagram (TO-BE)
Локальный сервис данных лояльности и обмен только через Integration Platform
end title


' =========================================================
' ВНЕШНИЕ УЧАСТНИКИ
' =========================================================

Person(cashier, "Кассир", "Сканирует товары и карту лояльности, принимает оплату, закрывает чек")
Person(admin, "Администратор магазина", "Открывает и закрывает смены, управляет кассами, оформляет возвраты")


' =========================================================
' POS — ЦЕЛЕВАЯ СИСТЕМА
' =========================================================

System_Boundary(pos, "POS (IS-04)") {

    Container(pos_app, "Кассовое приложение", "Desktop-приложение на кассовом узле", "Оформление продажи, применение скидок и бонусов, формирование чека. Скидки берёт из локального сервиса, при наличии связи может запросить актуальные данные через IP", $tags="key")
    Container(fiscal, "Фискальный модуль", "Драйвер ККТ", "Печать и фискализация чека")
    Container(backoffice, "Бэк-офис магазина", "Web-приложение", "Управление сменами и кассирами, возвраты, просмотр продаж магазина")
    ContainerDb(pos_db, "БД POS", "Реляционная СУБД", "Чеки, кассовые смены, журнал операций, Outbox (очередь неотправленных продаж)")

    Container(loyalty_svc, "Сервис локальных данных лояльности", "Фоновый сервис на кассовом узле", "Периодически загружает скидки и данные лояльности из CRM, отдаёт их кассовому приложению локально, при восстановлении связи отправляет накопленные продажи из Outbox", $tags="new")
    ContainerDb(loyalty_db, "Локальное хранилище скидок", "Локальная БД / кэш", "Копия скидок и данных лояльности из CRM, время последней синхронизации", $tags="new")
}


' =========================================================
' ВНЕШНИЕ СИСТЕМЫ
' =========================================================

System_Ext(ip, "Integration Platform (IS-07)", "Единый интеграционный слой: маршрутизация, повторы, доставка")
System_Ext(erp, "ERP", "Цены, акции, учёт продаж и остатков")
System_Ext(crm, "CRM", "Клиенты, бонусы, скидки, история покупок")


' =========================================================
' СВЯЗИ
' =========================================================

Rel(cashier, pos_app, "Сканирует товары и карту, закрывает чек")
Rel(admin, backoffice, "Управляет сменами и операциями магазина")

Rel(pos_app, fiscal, "Печать и фискализация чека", "API драйвера")
Rel(pos_app, pos_db, "Сохраняет чеки, операции и записи Outbox", "SQL")
Rel(backoffice, pos_db, "Читает продажи, ведёт смены и возвраты", "SQL")

' Новое: скидки из локального сервиса
Rel(pos_app, loyalty_svc, "Запрашивает скидки и бонусы по карте", "REST / локальный API")
Rel(loyalty_svc, loyalty_db, "Читает и обновляет копию скидок", "SQL")

' Обмен с внешним миром только через IP
Rel(pos_app, ip, "Запрос цены и акций (ERP). При наличии связи: актуальные скидки (CRM)", "REST")
Rel(loyalty_svc, pos_db, "Читает Outbox, отмечает отправленные записи", "SQL")
Rel(loyalty_svc, ip, "Периодическая загрузка скидок (CRM). Отправка накопленных продаж (ERP, CRM) пакетом", "REST", $tags="async")

Rel(ip, erp, "Цены, акции. Приём фактов продаж", "API ERP")
Rel(ip, crm, "Скидки и бонусы. Приём продаж по карте лояльности", "API CRM")

note right of loyalty_svc
Новый контейнер TO-BE.
Работает независимо от кассового
приложения: касса получает скидки
локально и не ждёт ответа CRM.
При потере связи скидки берутся
из локального хранилища,
продажи копятся в Outbox.
end note

note bottom of ip
TO-BE: POS не обращается к ERP и CRM
напрямую, все обмены идут через IP.
Продажи уходят пакетом с повторами
после восстановления связи.
end note

SHOW_LEGEND()

@enduml