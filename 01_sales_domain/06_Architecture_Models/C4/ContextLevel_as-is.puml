@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Настройки для улучшения читаемости
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title C4 System Context: Оффлайн-продажи (Фокус на взаимодействии POS и CRM)

' Определяем участников диаграммы.
Person(customer, "Покупатель", "Совершает оффлайн-покупку")
Person(cashier, "Старший продавец магазина", "Обслуживает покупателя на кассовом узле или рабочем месте")

' Определяем компоненты (узлы) диаграммы.
System_Boundary(project_scope, "Границы взаимодействия POS и CRM") {
    
    System(pos, "POS-система", "Кассовое ПО и АРМ продавца. Оформление продаж")
    
    System(crm, "CRM-система", "Проверка статуса, баланса и применение бонусов/скидок в момент продажи")
    
}

' Определяем связи компонентов (узлов) диаграммы.
Rel(customer, cashier, "1. Передает товары и/или карту лояльности")
Rel(cashier, pos, "2. Сканирует товары, инициирует продажу")

' Прямое взаимодействие POS и CRM (Проблема из As-Is)
Rel(pos, crm, "Синхронный запрос: проверка карты лояльности, баланс, применение скидки\n(Узкое место из As-Is: Задержки увеличивают время продажи)", "REST/SOAP")

@enduml